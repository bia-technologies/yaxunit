#Область СлужебныйПрограммныйИнтерфейс

// Возвращает имя стандартного реквизита на языке конфигурации.
// 
// Например, для английского варианта встроенного языка вернет `Ref` для реквизита `Ссылка`.
// 
// Параметры:
//  ИмяРеквизита - Строка - Русское (основное) имя стандартного реквизита, см. ИменаСтандартныхРеквизитов
// 
// Возвращаемое значение:
//  Строка - Имя реквизита на языке текущей конфигурации
Функция ИмяРеквизита(Знач ИмяРеквизита) Экспорт
	
	АнглийскийЯзык = ЮТОкружение.ИспользуетсяАнглийскийВстроенныйЯзык();
	ИмяНаЯзыкеКонфигурации = ?(АнглийскийЯзык, СоответствиеИменРеквизитов()[ИмяРеквизита], ИмяРеквизита);
	
	Если ИмяНаЯзыкеКонфигурации = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестное имя стандартного реквизита `%1`", ИмяРеквизита);
	КонецЕсли;
	
	Возврат ИмяНаЯзыкеКонфигурации;
	
КонецФункции

// Проверяет, что имя является именем стандартного реквизита.
// 
// Параметры:
//  ИмяРеквизита - Строка - Имя реквизита в любом варианте языка (ru/en)
// 
// Возвращаемое значение:
//  Булево - Это имя стандартного реквизита
Функция ЭтоСтандартныйРеквизит(Знач ИмяРеквизита) Экспорт
	
	Возврат ОсновноеИмяРеквизита(ИмяРеквизита) <> Неопределено;
	
КонецФункции

// Возвращает основное (русское) имя стандартного реквизита по имени в любом варианте языка.
// 
// Параметры:
//  ИмяРеквизита - Строка - Имя реквизита в любом варианте языка (ru/en)
// 
// Возвращаемое значение:
//  Строка - Основное имя реквизита
//  Неопределено - Не является стандартным реквизитом
Функция ОсновноеИмяРеквизита(Знач ИмяРеквизита) Экспорт
	
	Возврат ОбратноеСоответствиеИмен()[ИмяРеквизита];
	
КонецФункции

// Имена стандартных реквизитов (основные, русские).
// 
// Возвращаемое значение:
//  Структура Из КлючИЗначение:
//  * Ключ - Строка - Основное имя реквизита
//  * Значение - Строка - Английское имя реквизита
Функция ИменаСтандартныхРеквизитов() Экспорт
	
	Возврат СоответствиеИменРеквизитов();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоответствиеИменРеквизитов()
	
	Имена = Новый Соответствие;
	
	// Общие стандартные реквизиты объектов и таблиц
	Имена.Вставить("Ссылка", "Ref");
	Имена.Вставить("Код", "Code");
	Имена.Вставить("Наименование", "Description");
	Имена.Вставить("Номер", "Number");
	Имена.Вставить("Дата", "Date");
	Имена.Вставить("Период", "Period");
	Имена.Вставить("Регистратор", "Recorder");
	Имена.Вставить("НомерСтроки", "LineNumber");
	Имена.Вставить("Активность", "Active");
	Имена.Вставить("ПометкаУдаления", "DeletionMark");
	Имена.Вставить("ЭтоГруппа", "IsFolder");
	Имена.Вставить("Владелец", "Owner");
	Имена.Вставить("Родитель", "Parent");
	Имена.Вставить("Предопределенный", "Predefined");
	Имена.Вставить("ВидДвижения", "RecordType");
	Имена.Вставить("Проведен", "Posted");
	Имена.Вставить("Получатель", "Receiver");
	Имена.Вставить("Отправитель", "Sender");
	Имена.Вставить("ИмяПредопределенныхДанных", "PredefinedDataName");
	
	// Реквизиты корреспонденции счетов (регистр бухгалтерии, корреспонденция включена)
	Имена.Вставить("Счет", "Account");
	Имена.Вставить("ВидСубконто", "ExtDimensionType");
	Имена.Вставить("Субконто", "ExtDimension");
	Имена.Вставить("Дт", "Dr");
	Имена.Вставить("Кт", "Cr");
	
	Возврат Имена;
	
КонецФункции

Функция ОбратноеСоответствиеИмен()
	
	ОбратноеСоответствие = Новый Соответствие;
	
	Для Каждого Пара Из СоответствиеИменРеквизитов() Цикл
		ОбратноеСоответствие.Вставить(Пара.Ключ, Пара.Ключ);
		ОбратноеСоответствие.Вставить(Пара.Значение, Пара.Ключ);
	КонецЦикла;
	
	Возврат ОбратноеСоответствие;
	
КонецФункции

#КонецОбласти
