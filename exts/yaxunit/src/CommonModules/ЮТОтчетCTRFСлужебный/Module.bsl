#Область СлужебныйПрограммныйИнтерфейс

// Параметры генерации отчета.
// Описывает предоставляемые модулем форматы отчетов.
//
// Возвращаемое значение:
//  Структура - см. ЮТФабрикаСлужебный.ПараметрыГенератораОтчета
//
// Пример:
//  Параметры = ЮТОтчетCTRFСлужебный.ПараметрыГенерацииОтчета();
Функция ПараметрыГенерацииОтчета() Экспорт
	
	Параметры = ЮТФабрикаСлужебный.ПараметрыГенератораОтчета();
	
	ОписаниеФормата = ЮТФабрикаСлужебный.ОписаниеФорматаОтчета("ctrf", "CTRF (json)");
	ОписаниеФормата.ИмяФайлаПоУмолчанию = "ctrf-report.json";
	ОписаниеФормата.ФильтрВыбораФайла = "CTRF (*.json)|*.json";
	Параметры.Форматы.Вставить(ОписаниеФормата.Идентификатор, ОписаниеФормата);
	
	Возврат Параметры;
	
КонецФункции

// Формирует отчет в формате CTRF (Common Test Report Format) версии 0.2.0.
//
// Структура отчета (strict core):
//  * reportFormat - Строка - всегда "CTRF"
//  * specVersion - Строка - всегда "0.2.0"
//  * results - Соответствие:
//      + tool - {name: "YAxUnit", version}
//      + summary - см. ЮТОтчетCTRFСлужебный.Сводка
//      + tests - Массив из см. ЮТОтчетCTRFСлужебный.ОписаниеТеста
//      + environment - опциональный раздел, только при заполненных данных окружения
//
// Отчет записывается потоково, без построения полного документа в памяти:
// сводка считается предварительным проходом (см. ЮТОтчетCTRFСлужебный.Сводка),
// затем разделы отчета пишутся в JSON-поток по мере обхода результатов.
//
// Не поддерживается в web-клиенте.
//
// Параметры:
//  РезультатВыполнения - Массив из см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//  Формат - см. ЮТФабрикаСлужебный.ОписаниеФорматаОтчета
//
// Возвращаемое значение:
//  ДвоичныеДанные - Данные отчета
//
// Пример:
//  Данные = ЮТОтчетCTRFСлужебный.ДанныеОтчета(РезультатВыполнения, Формат);
Функция ДанныеОтчета(Знач РезультатВыполнения, Формат) Экспорт
	
#Если ВебКлиент Тогда
	ВызватьИсключение "Формирование отчета в формате CTRF не поддерживается в web-клиенте";
#Иначе
	СводкаПрогона = Сводка(РезультатВыполнения);
	
	Поток = Новый ПотокВПамяти();
	Запись = Новый ЗаписьJSON();
	Запись.ОткрытьПоток(Поток, "UTF-8", Ложь);
	
	ЗаписатьДокументОтчета(Запись, РезультатВыполнения, СводкаПрогона);
	
	Запись.Закрыть();
	
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
#КонецЕсли
	
КонецФункции

// Преобразует статус исполнения теста в статус теста отчета CTRF.
//
// Параметры:
//  Статус - Строка - Статус исполнения теста, см. ЮТФабрика.СтатусыИсполненияТеста
//
// Возвращаемое значение:
//  Строка - Статус теста CTRF:
//   * passed - тест пройден (Успешно)
//   * failed - тест упал (Ошибка, Сломан)
//   * skipped - тест пропущен (Пропущен, НеРеализован, Ожидание)
//   * other - прочие статусы (Исполнение)
//
// Пример:
//  Статус = ЮТОтчетCTRFСлужебный.СтатусОтчета(ЮТФабрика.СтатусыИсполненияТеста().Сломан); // failed
Функция СтатусОтчета(Знач Статус) Экспорт
	
	Статусы = ЮТФабрика.СтатусыИсполненияТеста();
	
	Если Статус = Статусы.Успешно Тогда
		СтатусОтчета = "passed";
	ИначеЕсли Статус = Статусы.Ошибка Или Статус = Статусы.Сломан Тогда
		СтатусОтчета = "failed";
	ИначеЕсли Статус = Статусы.Пропущен Или Статус = Статусы.НеРеализован Или Статус = Статусы.Ожидание Тогда
		СтатусОтчета = "skipped";
	Иначе
		СтатусОтчета = "other";
	КонецЕсли;
	
	Возврат СтатусОтчета;
	
КонецФункции

// Формирует описание теста для отчета CTRF.
//
// Параметры:
//  РезультатТеста - см. ЮТФабрика.ОписаниеИсполняемогоТеста
//  Набор - см. ЮТФабрика.ОписаниеИсполняемогоНабораТестов
//  Модуль - см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//
// Возвращаемое значение:
//  Соответствие - Описание теста CTRF, ключи - строки:
//   * name - Строка - имя теста
//   * status - Строка - см. ЮТОтчетCTRFСлужебный.СтатусОтчета
//   * duration - Число - длительность теста в миллисекундах
//   * suite - Массив из Строка - имена модуля и набора
//   * rawStatus - Строка - исходный статус YAxUnit, только для не 1:1 маппинга статусов
//   * message - Строка - сообщение первой ошибки, только для непройденных тестов с заполненным сообщением
//   * trace - Строка - стек первой ошибки, только для непройденных тестов с заполненным стеком
//   * start - Число - время начала теста в Unix-миллисекундах
//   * tags - Массив из Строка - уникальные теги модуля, набора и теста
//
// Пример:
//  Описание = ЮТОтчетCTRFСлужебный.ОписаниеТеста(РезультатТеста, Набор, Модуль);
Функция ОписаниеТеста(РезультатТеста, Набор, Модуль) Экспорт
	
	СтатусЗаписи = СтатусОтчета(РезультатТеста.Статус);
	
	Описание = Новый Соответствие;
	Описание.Вставить("name", РезультатТеста.Имя);
	Описание.Вставить("status", СтатусЗаписи);
	Описание.Вставить("duration", РезультатТеста.Длительность);
	Описание.Вставить("suite", ЮТКоллекции.ЗначениеВМассиве(Модуль.Метаданные.Имя, Набор.Имя));
	
	Если ЕстьИсходныйСтатус(РезультатТеста.Статус) Тогда
		Описание.Вставить("rawStatus", РезультатТеста.Статус);
	КонецЕсли;
	
	Если РезультатТеста.Ошибки.Количество() > 0 И СтатусЗаписи <> "passed" И СтатусЗаписи <> "skipped" Тогда
		
		ВставитьОшибку(Описание, РезультатТеста.Ошибки[0]);
		
	КонецЕсли;
	
	Теги = ЮТОтчетСлужебныйКлиентСервер.УникальныеТеги(Модуль, Набор, РезультатТеста);
	Если Теги.Количество() > 0 Тогда
		Описание.Вставить("tags", Теги);
	КонецЕсли;
	
	Если РезультатТеста.ДатаСтарта > 0 Тогда
		Описание.Вставить("start", ЮниксВремя(РезультатТеста.ДатаСтарта));
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

// Формирует сводку результатов прогона по результатам выполнения.
//
// Выполняет предварительный проход по результатам: учитывает статусы тестов
// (см. ЮТОтчетCTRFСлужебный.СтатусОтчета) и синтетические failed-записи ошибок
// наборов и модулей. Времена агрегируются только по тестам с заполненной датой старта,
// синтетические записи времени не содержат.
//
// Параметры:
//  РезультатВыполнения - Массив из см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//
// Возвращаемое значение:
//  Соответствие - Сводка прогона, ключи - строки:
//   * tests - Число - количество записей отчета (тесты + синтетические записи ошибок)
//   * passed - Число - количество тестов со статусом passed
//   * failed - Число - количество тестов и синтетических записей со статусом failed
//   * pending - Число - всегда 0, статус не формируется статусами YAxUnit
//   * skipped - Число - количество тестов со статусом skipped
//   * other - Число - количество тестов со статусом other
//   * start - Число - минимальное время начала тестов в Unix-миллисекундах, 0 при отсутствии данных
//   * stop - Число - максимальное время окончания тестов в Unix-миллисекундах, 0 при отсутствии данных
//
// Пример:
//  Сводка = ЮТОтчетCTRFСлужебный.Сводка(РезультатВыполнения);
Функция Сводка(Знач РезультатВыполнения) Экспорт
	
	Счетчики = НовыеСчетчикиПрогона();
	
	Для Каждого Модуль Из РезультатВыполнения Цикл
		
		Для Каждого Набор Из Модуль.НаборыТестов Цикл
			
			Для Каждого Тест Из Набор.Тесты Цикл
				УчестьРезультатТеста(Счетчики, Тест);
			КонецЦикла;
			
			Если Набор.Ошибки.Количество() > 0 Тогда
				УчестьСинтетическуюЗапись(Счетчики);
			КонецЕсли;
			
		КонецЦикла;
		
		Если Модуль.Ошибки.Количество() > 0 Тогда
			УчестьСинтетическуюЗапись(Счетчики);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СводкаПоСчетчикам(Счетчики);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует счетчики сводки прогона для предварительного прохода.
//
// Возвращаемое значение:
//  Структура - со свойствами:
//   * tests - Число - количество записей отчета
//   * passed - Число - количество записей со статусом passed
//   * failed - Число - количество записей со статусом failed
//   * pending - Число - количество записей со статусом pending
//   * skipped - Число - количество записей со статусом skipped
//   * other - Число - количество записей со статусом other
//   * start - Число - минимальное время начала тестов в Unix-миллисекундах
//   * stop - Число - максимальное время окончания тестов в Unix-миллисекундах
Функция НовыеСчетчикиПрогона()
	
	Счетчики = Новый Структура;
	Счетчики.Вставить("tests", 0);
	Счетчики.Вставить("passed", 0);
	Счетчики.Вставить("failed", 0);
	Счетчики.Вставить("pending", 0);
	Счетчики.Вставить("skipped", 0);
	Счетчики.Вставить("other", 0);
	Счетчики.Вставить("start", 0);
	Счетчики.Вставить("stop", 0);
	
	Возврат Счетчики;
	
КонецФункции

// Учитывает результат теста в счетчиках сводки прогона.
// Инкрементирует общий счетчик и счетчик статуса записи отчета, агрегирует времена:
// start - минимальное время начала теста, stop - максимальное время окончания (начало + длительность).
// Тесты с незаполненной датой старта времена не дают.
//
// Параметры:
//  Счетчики - см. ЮТОтчетCTRFСлужебный.НовыеСчетчикиПрогона - счетчики сводки прогона
//  Тест - см. ЮТФабрика.ОписаниеИсполняемогоТеста
Процедура УчестьРезультатТеста(Знач Счетчики, Знач Тест)
	
	СтатусЗаписи = СтатусОтчета(Тест.Статус);
	
	Счетчики.tests = Счетчики.tests + 1;
	Счетчики[СтатусЗаписи] = Счетчики[СтатусЗаписи] + 1;
	
	Если Тест.ДатаСтарта > 0 Тогда
		
		НачалоТеста = ЮниксВремя(Тест.ДатаСтарта);
		
		Если Счетчики.start = 0 Или НачалоТеста < Счетчики.start Тогда
			Счетчики.start = НачалоТеста;
		КонецЕсли;
		
		ОкончаниеТеста = НачалоТеста + Тест.Длительность;
		Если ОкончаниеТеста > Счетчики.stop Тогда
			Счетчики.stop = ОкончаниеТеста;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Учитывает синтетическую запись ошибки набора/модуля в счетчиках сводки прогона.
// Синтетические записи всегда имеют статус failed и не содержат времени.
//
// Параметры:
//  Счетчики - см. ЮТОтчетCTRFСлужебный.НовыеСчетчикиПрогона - счетчики сводки прогона
Процедура УчестьСинтетическуюЗапись(Знач Счетчики)
	
	Счетчики.tests = Счетчики.tests + 1;
	Счетчики.failed = Счетчики.failed + 1;
	
КонецПроцедуры

// Формирует сводку отчета CTRF по счетчикам предварительного прохода.
//
// Параметры:
//  Счетчики - см. ЮТОтчетCTRFСлужебный.НовыеСчетчикиПрогона
//
// Возвращаемое значение:
//  Соответствие - см. ЮТОтчетCTRFСлужебный.Сводка
Функция СводкаПоСчетчикам(Знач Счетчики)
	
	Сводка = Новый Соответствие;
	Сводка.Вставить("tests", Счетчики.tests);
	Сводка.Вставить("passed", Счетчики.passed);
	Сводка.Вставить("failed", Счетчики.failed);
	Сводка.Вставить("pending", Счетчики.pending);
	Сводка.Вставить("skipped", Счетчики.skipped);
	Сводка.Вставить("other", Счетчики.other);
	Сводка.Вставить("start", Счетчики.start);
	Сводка.Вставить("stop", Счетчики.stop);
	
	Возврат Сводка;
	
КонецФункции

// Записывает корневой документ CTRF-отчета в JSON-поток.
// Заполняет только поля строгого ядра спецификации 0.2.0: reportFormat, specVersion, results.
//
// Параметры:
//  Запись - ЗаписьJSON - запись отчета
//  РезультатВыполнения - Массив из см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//  Сводка - см. ЮТОтчетCTRFСлужебный.Сводка - предварительно посчитанная сводка прогона
Процедура ЗаписатьДокументОтчета(Знач Запись, Знач РезультатВыполнения, Знач Сводка)
	
	Запись.ЗаписатьНачалоОбъекта();
	
	Запись.ЗаписатьИмяСвойства("reportFormat");
	Запись.ЗаписатьЗначение("CTRF");
	
	Запись.ЗаписатьИмяСвойства("specVersion");
	Запись.ЗаписатьЗначение("0.2.0");
	
	Запись.ЗаписатьИмяСвойства("results");
	ЗаписатьРезультаты(Запись, РезультатВыполнения, Сводка);
	
	Запись.ЗаписатьКонецОбъекта();
	
КонецПроцедуры

// Записывает раздел results CTRF-отчета: tool, summary, tests и опциональный environment.
//
// Параметры:
//  Запись - ЗаписьJSON - запись отчета
//  РезультатВыполнения - Массив из см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//  Сводка - см. ЮТОтчетCTRFСлужебный.Сводка - предварительно посчитанная сводка прогона
Процедура ЗаписатьРезультаты(Знач Запись, Знач РезультатВыполнения, Знач Сводка)
	
	Окружение = ЮТест.Окружение();
	
	Запись.ЗаписатьНачалоОбъекта();
	
	Запись.ЗаписатьИмяСвойства("tool");
	ЗаписатьИнструмент(Запись, Окружение);
	
	Запись.ЗаписатьИмяСвойства("summary");
	ЗаписатьСводку(Запись, Сводка);
	
	Запись.ЗаписатьИмяСвойства("tests");
	ЗаписатьТесты(Запись, РезультатВыполнения);
	
	ОкружениеОтчета = РазделEnvironment(Окружение);
	Если ОкружениеОтчета <> Неопределено Тогда
		
		Запись.ЗаписатьИмяСвойства("environment");
		ЗаписатьJSON(Запись, ОкружениеОтчета);
		
	КонецЕсли;
	
	Запись.ЗаписатьКонецОбъекта();
	
КонецПроцедуры

// Записывает раздел tool CTRF-отчета: имя и версия тестового движка.
//
// Параметры:
//  Запись - ЗаписьJSON - запись отчета
//  Окружение - см. ЮТФабрика.НовоеОписаниеОкружения
Процедура ЗаписатьИнструмент(Знач Запись, Знач Окружение)
	
	Запись.ЗаписатьНачалоОбъекта();
	
	Запись.ЗаписатьИмяСвойства("name");
	Запись.ЗаписатьЗначение("YAxUnit");
	
	Запись.ЗаписатьИмяСвойства("version");
	Запись.ЗаписатьЗначение(Окружение.ВерсияТестовогоДвижка);
	
	Запись.ЗаписатьКонецОбъекта();
	
КонецПроцедуры

// Записывает раздел summary CTRF-отчета по предварительно посчитанной сводке.
//
// Параметры:
//  Запись - ЗаписьJSON - запись отчета
//  Сводка - см. ЮТОтчетCTRFСлужебный.Сводка
Процедура ЗаписатьСводку(Знач Запись, Знач Сводка)
	
	Запись.ЗаписатьНачалоОбъекта();
	
	Для Каждого Ключ Из ЮТКоллекции.ЗначениеВМассиве(
		"tests", "passed", "failed", "pending", "skipped", "other", "start", "stop") Цикл
		
		Запись.ЗаписатьИмяСвойства(Ключ);
		Запись.ЗаписатьЗначение(Сводка.Получить(Ключ));
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецОбъекта();
	
КонецПроцедуры

// Записывает массив tests CTRF-отчета по результатам выполнения.
// Каждая запись теста пишется в поток отдельно, массив записей в памяти не формируется.
// Для каждого модуля, набора и теста формируется запись, см. ЮТОтчетCTRFСлужебный.ОписаниеТеста.
// Набор с непустыми Ошибки и модуль с непустыми Ошибки дают синтетические записи со статусом failed
// (ошибка уровня набора/модуля не должна теряться в отчете).
//
// Параметры:
//  Запись - ЗаписьJSON - запись отчета
//  РезультатВыполнения - Массив из см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
Процедура ЗаписатьТесты(Знач Запись, Знач РезультатВыполнения)
	
	Запись.ЗаписатьНачалоМассива();
	
	Для Каждого Модуль Из РезультатВыполнения Цикл
		
		Для Каждого Набор Из Модуль.НаборыТестов Цикл
			
			Для Каждого Тест Из Набор.Тесты Цикл
				ЗаписатьJSON(Запись, ОписаниеТеста(Тест, Набор, Модуль));
			КонецЦикла;
			
			Если Набор.Ошибки.Количество() > 0 Тогда
				ЗаписатьJSON(Запись, ОписаниеОшибкиНабора(Набор, Модуль));
			КонецЕсли;
			
		КонецЦикла;
		
		Если Модуль.Ошибки.Количество() > 0 Тогда
			ЗаписатьJSON(Запись, ОписаниеОшибкиМодуля(Модуль));
		КонецЕсли;
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецМассива();
	
КонецПроцедуры

// Определяет необходимость заполнения исходного статуса YAxUnit в описании теста CTRF.
// Заполняется для статусов с не 1:1 соответствием статусам CTRF.
//
// Параметры:
//  Статус - Строка - Статус исполнения теста, см. ЮТФабрика.СтатусыИсполненияТеста
//
// Возвращаемое значение:
//  Булево - Истина, если статус требует сохранения в rawStatus
Функция ЕстьИсходныйСтатус(Статус)
	
	Статусы = ЮТФабрика.СтатусыИсполненияТеста();
	
	Возврат Статус = Статусы.Сломан
		Или Статус = Статусы.НеРеализован
		Или Статус = Статусы.Ожидание
		Или Статус = Статусы.Исполнение;
	
КонецФункции

// Преобразует метку времени 1С в Unix-время в миллисекундах.
//
// Параметры:
//  Метка - Число - Метка времени 1С в миллисекундах от 0001-01-01
//
// Возвращаемое значение:
//  Число - Unix-время в миллисекундах, 0 для незаполненной метки
Функция ЮниксВремя(Метка)
	
	Если Метка > 0 Тогда
		Возврат Метка - СмещениеЭпохи1С();
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// Смещение между эпохой 1С (0001-01-01) и Unix-эпохой (1970-01-01) в миллисекундах.
//
// Разность дат 1С выражается в секундах: от 0001-01-01 (эпоха 1С) до 1970-01-01 (Unix-эпоха)
// ровно 62135596800 секунд. Метки времени 1С - миллисекунды, поэтому смещение домножается
// на количество миллисекунд в секунде.
//
// Возвращаемое значение:
//  Число - 62135596800000 - количество миллисекунд от 0001-01-01 до 1970-01-01
Функция СмещениеЭпохи1С()
	
	МиллисекундВСекунде = 1000;
	СекундОтЭпохи1СДоUnix = Дата(1970, 1, 1) - Дата(1, 1, 1);
	
	Возврат СекундОтЭпохи1СДоUnix * МиллисекундВСекунде;
	
КонецФункции

// Формирует синтетическую запись теста для набора с ошибками исполнения.
// Ошибки уровня набора не представлены в модели CTRF напрямую - для них создается
// отдельная запись со статусом failed, чтобы ошибки прогона не терялись в отчете.
//
// Параметры:
//  Набор - см. ЮТФабрика.ОписаниеИсполняемогоНабораТестов
//  Модуль - см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//
// Возвращаемое значение:
//  Соответствие - Запись теста CTRF, ключи - строки:
//   * name - Строка - представление набора с режимом, "<Представление> [<Режим>]"
//   * status - Строка - всегда "failed"
//   * duration - Число - всегда 0
//   * suite - Массив из Строка - имя модуля
//   * message - Строка - сообщение первой ошибки набора, только для заполненного сообщения
//   * trace - Строка - стек первой ошибки набора, только для заполненного стека
Функция ОписаниеОшибкиНабора(Набор, Модуль)
	
	Описание = Новый Соответствие;
	Описание.Вставить("name", СтрШаблон("%1 [%2]", Набор.Представление, Набор.Режим));
	Описание.Вставить("status", "failed");
	Описание.Вставить("duration", 0);
	Описание.Вставить("suite", ЮТКоллекции.ЗначениеВМассиве(Модуль.Метаданные.Имя));
	ВставитьОшибку(Описание, Набор.Ошибки[0]);
	
	Возврат Описание;
	
КонецФункции

// Формирует синтетическую запись теста для модуля с ошибками исполнения.
// Ошибки уровня модуля не представлены в модели CTRF напрямую - для них создается
// отдельная запись со статусом failed. Свойство suite опускается: пустой массив
// suite запрещен схемой CTRF, а вышестоящего уровня у модуля нет.
//
// Параметры:
//  Модуль - см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//
// Возвращаемое значение:
//  Соответствие - Запись теста CTRF, ключи - строки:
//   * name - Строка - имя модуля
//   * status - Строка - всегда "failed"
//   * duration - Число - всегда 0
//   * message - Строка - сообщение первой ошибки модуля, только для заполненного сообщения
//   * trace - Строка - стек первой ошибки модуля, только для заполненного стека
Функция ОписаниеОшибкиМодуля(Модуль)
	
	Описание = Новый Соответствие;
	Описание.Вставить("name", Модуль.Метаданные.Имя);
	Описание.Вставить("status", "failed");
	Описание.Вставить("duration", 0);
	ВставитьОшибку(Описание, Модуль.Ошибки[0]);
	
	Возврат Описание;
	
КонецФункции

// Добавляет в запись теста CTRF сообщение и стек ошибки.
// message и trace - опциональные поля строгой схемы CTRF (значение обязано быть строкой),
// поэтому незаполненные значения не вставляются: Неопределено сериализуется в JSON null
// и делает отчет невалидным. Стек ошибки может быть Неопределено, см. ЮТРегистрацияОшибокСлужебный.СтекОшибки.
//
// Параметры:
//  Описание - Соответствие - формируемая запись теста CTRF
//  Ошибка - см. ЮТФабрикаСлужебный.ОписаниеВозникшейОшибки
Процедура ВставитьОшибку(Знач Описание, Знач Ошибка)
	
	Если ЗначениеЗаполнено(Ошибка.Сообщение) Тогда
		Описание.Вставить("message", Ошибка.Сообщение);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ошибка.Стек) Тогда
		Описание.Вставить("trace", Ошибка.Стек);
	КонецЕсли;
	
КонецПроцедуры

// Формирует опциональный раздел environment CTRF-отчета по данным окружения.
// Включаются только непустые поля: appName, appVersion, osPlatform; testEnvironment не заполняется.
// Возвращает Неопределено, если все поля пусты - раздел опускается.
//
// Параметры:
//  Окружение - см. ЮТФабрика.НовоеОписаниеОкружения
//
// Возвращаемое значение:
//  Соответствие, Неопределено - Раздел environment, ключи - строки:
//   * appName - Строка - имя конфигурации
//   * appVersion - Строка - версия конфигурации
//   * osPlatform - Строка - операционная система сервера
Функция РазделEnvironment(Знач Окружение)
	
	Раздел = Новый Соответствие;
	
	Если ЗначениеЗаполнено(Окружение.Конфигурация) Тогда
		Раздел.Вставить("appName", Окружение.Конфигурация);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Окружение.ВерсияКонфигурации) Тогда
		Раздел.Вставить("appVersion", Окружение.ВерсияКонфигурации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Окружение.ОперационнаяСистемаСервер) Тогда
		Раздел.Вставить("osPlatform", Окружение.ОперационнаяСистемаСервер);
	КонецЕсли;
	
	Если Раздел.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Раздел;
	
КонецФункции

#КонецОбласти
