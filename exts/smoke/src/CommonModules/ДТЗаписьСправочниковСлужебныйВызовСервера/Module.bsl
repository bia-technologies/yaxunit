#Область СлужебныйПрограммныйИнтерфейс

// Возвращает массив тестов для справочников
// 
// Возвращаемое значение:
//   - Массив описаний записей справочников. Структура с ключевыми реквизитами
//
Функция СправочникиДляЗаписи() Экспорт
	
	ПараметрыТестов = ПереопределеннаяНастройка(ЮТДымовыеТесты.ПараметрыДымовыхТестов(), "ЗаписьСправочников");
	НастройкаСправочников = ПереопределеннаяНастройка(ПараметрыТестов, "Справочники");
	
	Результат = Новый Массив;
	
	Для Каждого ОбъектМетаданных Из Метаданные.Справочники Цикл
		
		НастройкаСправочника = НастройкаСправочникаДляЗаписи(ОбъектМетаданных, НастройкаСправочников);
		Если НастройкаСправочника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкаСправочника.Элементы Тогда
			Результат.Добавить(ОписаниеЗаписиСправочника(ОбъектМетаданных, "Элементы", "Элемент", "существующий элемент"));
		КонецЕсли;
		
		Если НастройкаСправочника.Группы И СправочникПоддерживаетГруппы(ОбъектМетаданных) Тогда
			Результат.Добавить(ОписаниеЗаписиСправочника(ОбъектМетаданных, "Группы", "Группа", "существующая группа"));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СсылкаСправочника(ИмяСправочника, КлючНастройки) Экспорт
		
	Возврат СсылкаЭлементаСправочника(ИмяСправочника, КлючНастройки);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НастройкаСправочникаДляЗаписи(ОбъектМетаданных, НастройкаСправочников)
	
	Если НЕ ПравоДоступа("Изменение", ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЮТДымовыеТестыСлужебныйКлиентСервер.ПодходитПодНаборыИсключений(ОбъектМетаданных.Имя,
																			НастройкаСправочников.НаборыИсключений) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НастройкаОбъекта = ПереопределеннаяНастройка(НастройкаСправочников, ОбъектМетаданных.Имя); 
	
	Если НЕ НастройкаОбъекта.Использовать Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат НастройкаОбъекта;
	
КонецФункции

Функция ОписаниеЗаписиСправочника(ОбъектМетаданных, КлючНастройки, Тег, Представление)
	
	ОписаниеЗаписи = Новый Структура;
	ОписаниеЗаписи.Вставить("Тип", "Справочник");
	ОписаниеЗаписи.Вставить("Имя", ОбъектМетаданных.Имя);
	ОписаниеЗаписи.Вставить("КлючНастройки", КлючНастройки);
	ОписаниеЗаписи.Вставить("Тег", Тег);
	ОписаниеЗаписи.Вставить("Представление", Представление);
	
	Возврат ОписаниеЗаписи;
	
КонецФункции

Функция СсылкаЭлементаСправочника(ИмяСправочника, КлючНастройки)

	СправочникМетаданных = Метаданные.Справочники.Найти(ИмяСправочника);
	
	Запрос = Новый Запрос;  
	
	Если КлючНастройки = "Элементы" И СправочникПоддерживаетГруппы(СправочникМетаданных) Тогда
		УсловиеНаГруппу = "И НЕ Справочники.ЭтоГруппа";	 
	ИначеЕсли КлючНастройки = "Группы" Тогда   
		УсловиеНаГруппу = "И Справочники.ЭтоГруппа";
	Иначе
		УсловиеНаГруппу = "";
	КонецЕсли;  
	
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Справочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Справочники
		|ГДЕ
		|	НЕ Справочники.ПометкаУдаления
		|	И НЕ Справочники.Предопределенный
		|	%2
		|
		|УПОРЯДОЧИТЬ ПО
		|	Справочники.Ссылка УБЫВ", ИмяСправочника, УсловиеНаГруппу); // BSLLS:QueryParseError-off
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

Функция СправочникПоддерживаетГруппы(СправочникМетаданных)
	
	Возврат СправочникМетаданных.Иерархический
		И СправочникМетаданных.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	
КонецФункции

Функция БазоваяНастройка()
	
	Настройка = Новый Структура;
	Настройка.Вставить("Использовать", Истина);
	Настройка.Вставить("НаборыИсключений", Новый Массив);
	Настройка.Вставить("Элементы", Истина);
	Настройка.Вставить("Группы", Истина);
	
	Возврат Настройка;
	
КонецФункции

Функция ПереопределеннаяНастройка(БазоваяНастройка, Ключ)
	
	ТекущаяНастройка = ЮТКоллекции.ЗначениеСтруктуры(БазоваяНастройка, Ключ);
	
	Если ТекущаяНастройка = Неопределено Тогда
		Возврат БазоваяНастройка;
	КонецЕсли;
	
	Настройка = БазоваяНастройка();
	ЗаполнитьЗначенияСвойств(Настройка, БазоваяНастройка);
	
	ТипНастройки = ТипЗнч(ТекущаяНастройка);    
	
	Если ТипНастройки = Тип("Булево") Тогда
		ТекущаяНастройка = Новый Структура("Использовать", ТекущаяНастройка);
	ИначеЕсли ТекущаяНастройка.Свойство("Исключения") И ЗначениеЗаполнено(ТекущаяНастройка.Исключения) Тогда
		Исключения = ЮТДымовыеТестыСлужебныйКлиентСервер.НормализованнаяНастройкаИсключений(ТекущаяНастройка.Исключения);
		
		НаборыИсключений = ЮТКоллекции.СкопироватьМассив(Настройка.НаборыИсключений, Ложь);
		НаборыИсключений.Добавить(Исключения);  
		
		Настройка.НаборыИсключений = НаборыИсключений;
	КонецЕсли;
	
	ЮТКоллекции.ДополнитьСтруктуру(Настройка, ТекущаяНастройка);
	
	Возврат Настройка;
	
КонецФункции

#КонецОбласти
