#Область СлужебныйПрограммныйИнтерфейс

Функция ПроверкиПрав() Экспорт
	
	НастройкиПроверкиПрав = ЮТКоллекции.ЗначениеСтруктуры(ЮТДымовыеТесты.ПараметрыДымовыхТестов(), "ПроверкаПрав");
	
	Результат = Новый Структура;    
	
	КлючИнтерактивногоУдаления = "ИнтерактивноеУдаление";
	Результат.Вставить(КлючИнтерактивногоУдаления, ПроверкиОтсутствияПрава(НастройкиПроверкиПрав,
						КлючИнтерактивногоУдаления, КлючИнтерактивногоУдаления,
						"Интерактивное удаление", "нет права интерактивного удаления"));
																			
	КлючИнтерактивногоУдаленияПомеченных = "ИнтерактивноеУдалениеПомеченных";
	Результат.Вставить(КлючИнтерактивногоУдаленияПомеченных, ПроверкиОтсутствияПрава(НастройкиПроверкиПрав,
						КлючИнтерактивногоУдаленияПомеченных, КлючИнтерактивногоУдаленияПомеченных,
						"Интерактивное удаление помеченных", "нет права интерактивного удаления помеченных"));
	
	Результат.Вставить("ЧтениеНеАдминистраторами", ПроверкиЧтенияНеАдминистраторами(НастройкиПроверкиПрав));
	
	Возврат Результат;
	
КонецФункции

Функция РолиСПравом(ПолноеИмяМетаданных, Право, ИсключенияРолей) Экспорт
	
	Результат = Новый Массив;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяМетаданных);
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Роль Из Метаданные.Роли Цикл
		
		Если РольИсключенаИзПроверки(Роль, ИсключенияРолей) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЕстьПраво = ПравоДоступа(Право, ОбъектМетаданных, Роль);
		Исключение
			ЕстьПраво = Ложь;
		КонецПопытки;
		
		Если ЕстьПраво Тогда
			Результат.Добавить(Роль.Имя);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверкиОтсутствияПрава(НастройкиПроверкиПрав, КлючПроверки, Право, Тег, Представление)
	
	НастройкаПроверки = НастройкаВидаПроверки(НастройкиПроверкиПрав, КлючПроверки); 
	
	Результат = Новый Массив;
	
	Если НЕ НастройкаПроверки.Использовать Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ИмяКоллекции Из КоллекцииМетаданныхДляИнтерактивногоУдаления() Цикл
		ДобавитьПроверкиКоллекцииМетаданных(Результат, ИмяКоллекции, НастройкаПроверки, КлючПроверки, Право, Тег, Представление);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверкиЧтенияНеАдминистраторами(НастройкиПроверкиПрав)
	
	КлючПроверки = "ЧтениеНеАдминистраторами";
	НастройкаПроверки = НастройкаВидаПроверки(НастройкиПроверкиПрав, КлючПроверки);
	
	Результат = Новый Массив;
	
	Если НЕ НастройкаПроверки.Использовать Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ИмяКоллекции Из КоллекцииМетаданныхДляЧтенияНеАдминистраторами() Цикл
		ДобавитьПроверкиКоллекцииМетаданных(Результат, ИмяКоллекции, НастройкаПроверки, КлючПроверки, 
											"Чтение", "Чтение не администраторами", "есть чтение не администраторами");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьПроверкиКоллекцииМетаданных(Результат, ИмяКоллекции, НастройкаПроверки, КлючПроверки, Право, Тег, Представление)
	
	Для Каждого ОбъектМетаданных Из Метаданные[ИмяКоллекции] Цикл
		
		Если ЮТДымовыеТестыСлужебныйКлиентСервер.ПодходитПодНаборыИсключений(ОбъектМетаданных.Имя,
			НастройкаПроверки.НаборыИсключений) Тогда
			
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(ОписаниеПроверкиПрав(ОбъектМетаданных, ИмяКоллекции, КлючПроверки, Право, 
													Тег, Представление, НастройкаПроверки.ИсключенияРолей));
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеПроверкиПрав(ОбъектМетаданных, ИмяКоллекции, КлючПроверки, Право, Тег, Представление, ИсключенияРолей)
	
	ОписаниеПроверки = Новый Структура;
	ОписаниеПроверки.Вставить("Имя", ОбъектМетаданных.Имя);
	ОписаниеПроверки.Вставить("ПолноеИмя", ОбъектМетаданных.ПолноеИмя());
	ОписаниеПроверки.Вставить("ИмяКоллекции", ИмяКоллекции);
	ОписаниеПроверки.Вставить("КлючПроверки", КлючПроверки);
	ОписаниеПроверки.Вставить("Право", Право);
	ОписаниеПроверки.Вставить("Тег", Тег);
	ОписаниеПроверки.Вставить("Представление", Представление);
	ОписаниеПроверки.Вставить("ИсключенияРолей", ИсключенияРолей);
	
	Возврат ОписаниеПроверки;
	
КонецФункции

Функция НастройкаВидаПроверки(НастройкиПроверкиПрав, КлючПроверки)
	
	Настройка = БазоваяНастройкаВидаПроверки();
	ТекущаяНастройка = ЮТКоллекции.ЗначениеСтруктуры(НастройкиПроверкиПрав, КлючПроверки);
	
	Если ТекущаяНастройка = Неопределено Тогда
		Возврат Настройка;
	КонецЕсли;
	
	Если ТипЗнч(ТекущаяНастройка) = Тип("Булево") Тогда
		ТекущаяНастройка = Новый Структура("Использовать", ТекущаяНастройка);
	ИначеЕсли ТекущаяНастройка.Свойство("Исключения") И ЗначениеЗаполнено(ТекущаяНастройка.Исключения) Тогда
		Исключения = ЮТДымовыеТестыСлужебныйКлиентСервер.НормализованнаяНастройкаИсключений(ТекущаяНастройка.Исключения);
		Настройка.НаборыИсключений.Добавить(Исключения);
	КонецЕсли;
	
	ЮТКоллекции.ДополнитьСтруктуру(Настройка, ТекущаяНастройка);
	
	Если ТекущаяНастройка.Свойство("ИсключенияРолей") Тогда
		Настройка.ИсключенияРолей = ЮТДымовыеТестыСлужебныйКлиентСервер.НормализованнаяНастройкаИсключений(
										ТекущаяНастройка.ИсключенияРолей);
	КонецЕсли;
	
	Возврат Настройка;
	
КонецФункции

Функция БазоваяНастройкаВидаПроверки()
	
	Настройка = Новый Структура;
	Настройка.Вставить("Использовать", Истина);
	Настройка.Вставить("НаборыИсключений", Новый Массив);
	Настройка.Вставить("ИсключенияРолей", Новый Массив);
	
	Возврат Настройка;
	
КонецФункции

Функция РольИсключенаИзПроверки(Роль, ИсключенияРолей)
	
	Возврат Метаданные.ОсновныеРоли.Содержит(Роль)
		Или ЮТДымовыеТестыСлужебныйКлиентСервер.ПодходитПодИсключения(Роль.Имя, ИсключенияРолей);
	
КонецФункции

Функция КоллекцииМетаданныхДляИнтерактивногоУдаления()
	
	Коллекции = Новый Массив;
	Коллекции.Добавить("ПланыОбмена");
	Коллекции.Добавить("Справочники");
	Коллекции.Добавить("Документы");
	Коллекции.Добавить("ПланыВидовХарактеристик");
	Коллекции.Добавить("ПланыСчетов");
	Коллекции.Добавить("ПланыВидовРасчета");
	Коллекции.Добавить("БизнесПроцессы");
	Коллекции.Добавить("Задачи");
	
	Возврат Коллекции;
	
КонецФункции

