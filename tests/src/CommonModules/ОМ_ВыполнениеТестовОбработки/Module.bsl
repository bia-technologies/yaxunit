#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции(Ложь)
		.ДобавитьТест("ЗагрузитьТестыВременнойОбработки")
		.ДобавитьТест("ИсполняемыеСценарииВременнойОбработки")
		.ДобавитьТест("ВыполнитьТестыВременнойОбработки")
		.ДобавитьТест("ПропускТестаВОбработчикеСобытияПередТестом")
		.ДобавитьТест("ЛогированиеПропускаИзОбработчикаТестовогоМодуля")
		.ДобавитьТест("ЛогированиеОшибкиОбработчикаТестовогоМодуля")
	;
	
КонецПроцедуры

Процедура ЗагрузитьТестыВременнойОбработки() Экспорт
	
	Сценарии = СценарииОбработки();
	
	ЮТест.ОжидаетЧто(Сценарии)
		.Заполнено()
		.Свойство("Метаданные").Заполнено()
		.Свойство("Метаданные.Сервер").ЭтоИстина()
		.Свойство("Метаданные.КлиентУправляемоеПриложение").ЭтоЛожь()
		.Свойство("Метаданные.КлиентОбычноеПриложение").ЭтоЛожь()
		.Свойство("НаборыТестов").Заполнено()
		.Свойство("НаборыТестов[0].Тесты").Заполнено()
			.ЛюбойЭлементСодержитСвойствоСоЗначением("Имя", "ТестУспешно")
			.ЛюбойЭлементСодержитСвойствоСоЗначением("Имя", "ТестОшибка")
			.ЛюбойЭлементСодержитСвойствоСоЗначением("Имя", "ТестСломан")
		;
	
КонецПроцедуры

Процедура ИсполняемыеСценарииВременнойОбработки() Экспорт
	
	Сценарии = СценарииОбработки();
	ИсполняемыеСценарии = ЮТИсполнительСлужебныйКлиентСервер.ИсполняемыйТестовыйМодуль(Сценарии);
	ЮТест.ОжидаетЧто(ИсполняемыеСценарии)
		.Заполнено()
		.Свойство("Метаданные").Заполнено()
		.Свойство("Метаданные.Сервер").ЭтоИстина()
		.Свойство("Метаданные.КлиентУправляемоеПриложение").ЭтоЛожь()
		.Свойство("Метаданные.КлиентОбычноеПриложение").ЭтоЛожь()
		.Свойство("НаборыТестов").Заполнено()
		.Свойство("НаборыТестов[0].Тесты").Заполнено()
			.ЛюбойЭлементСодержитСвойствоСоЗначением("Имя", "ТестУспешно")
			.ЛюбойЭлементСодержитСвойствоСоЗначением("Имя", "ТестОшибка")
			.ЛюбойЭлементСодержитСвойствоСоЗначением("Имя", "ТестСломан")
		;
	
КонецПроцедуры

Процедура ВыполнитьТестыВременнойОбработки() Экспорт
	
	ТестовыйМодуль = ЮТест.ОписаниеТекущегоТестовогоМодуля();
	Набор = ЮТест.ОписаниеТекущегоТестовогоНабора();
	Тест = ЮТест.ОписаниеТекущегоТеста();
	Сценарии = СценарииОбработки();
	ИсполняемыеСценарии = ЮТИсполнительСлужебныйКлиентСервер.ИсполняемыйТестовыйМодуль(Сценарии);
	СтатусыИсполненияТеста = ЮТФабрика.СтатусыИсполненияТеста();
	
	Результат = ЮТИсполнительСлужебныйКлиентСервер.ВыполнитьГруппуНаборовТестов(ИсполняемыеСценарии.НаборыТестов, ИсполняемыеСценарии);
	
	ЮТест.ОжидаетЧто(Результат)
		.Заполнено()
		.Что(Результат[0])
			.Свойство("Тесты")
			.Свойство("Тесты[0].Статус").Равно(СтатусыИсполненияТеста.Успешно)
			.Свойство("Тесты[1].Статус").Равно(СтатусыИсполненияТеста.Ошибка)
			.Свойство("Тесты[2].Статус").Равно(СтатусыИсполненияТеста.Сломан)
	;
	
	ЮТСобытияСлужебный.ПередКаждымТестом(ОМ_ВыполнениеТестовОбработки, ТестовыйМодуль, Набор, Тест);
	
КонецПроцедуры

// Тест проверяет, что вызов ЮТест.Пропустить() в обработчике события `Перед` теста
// регистрируется как пропуск теста, а не как ошибка обработки события.
// См. #686
Процедура ПропускТестаВОбработчикеСобытияПередТестом() Экспорт
	
	ТипыОшибок = ЮТФабрикаСлужебный.ТипыОшибок();
	
	Тест = Новый Структура("Ошибки, ПолноеИмяМетода", Новый Массив(), "Модуль.ТестСПропускомВПередТестом");
	Модуль = ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля();
	ОписаниеСобытия = ЮТФабрикаСлужебный.ОписаниеСобытияИсполненияТестов(Модуль, Неопределено, Тест);
	
	ЮТест.ДобавитьСообщение("Сообщение из обработчика события");
	ЮТРегистрацияОшибокСлужебный.ЗарегистрироватьОшибкуСобытияИсполнения(
		"ПередКаждымТестом", ОписаниеСобытия, ОшибкаПропускаТеста());
	
	ЮТест.ОжидаетЧто(Тест)
		.Свойство("Ошибки").ИмеетДлину(1)
		.Свойство("Ошибки[0].ТипОшибки").Равно(ТипыОшибок.Пропущен)
		.Свойство("Ошибки[0].Сообщение").Содержит("Пропуск в обработчике события")
		// Сообщения пользователя и лог теста не должны теряться при формировании данных ошибки пропуска
		.Свойство("Ошибки[0].Лог").ИмеетДлину(1)
		.Свойство("Ошибки[0].Лог[0]").Содержит("Сообщение из обработчика события")
	;
	
КонецПроцедуры

// Тест A (issue #709): пропуск теста из обработчика события тестового модуля (`ПередКаждымТестом`)
// логируется в лог как информация («Пропуск теста (ПередКаждымТестом): <причина>»), а не как ошибка
// обработки события. Статус теста — «Пропущен».
Процедура ЛогированиеПропускаИзОбработчикаТестовогоМодуля() Экспорт
	
	Прогон = ВыполнитьТестыОбработкиСЛогом("ОбработкаСПропуском");
	СтатусыИсполненияТеста = ЮТФабрика.СтатусыИсполненияТеста();
	
	ЮТест.ОжидаетЧто(Прогон.Лог, "Лог прогона тестов с пропуском из обработчика события")
		.Содержит("Пропуск теста (ПередКаждымТестом)")
		.Содержит("Причина пропуска")
		.НеСодержит("[ERR]: Ошибка обработки события")
		.НеСодержит("[Skip]");
	
	ЮТест.ОжидаетЧто(Прогон.Набор, "Статус теста при пропуске из обработчика события")
		.Заполнено()
		.Свойство("Тесты[0].Статус").Равно(СтатусыИсполненияТеста.Пропущен);
	
КонецПроцедуры

// Тест B (issue #709): реальная ошибка (не пропуск) из обработчика события тестового модуля
// логируется как ошибка обработки события, статус теста — «Сломан» (ошибка исполнения).
Процедура ЛогированиеОшибкиОбработчикаТестовогоМодуля() Экспорт
	
	Прогон = ВыполнитьТестыОбработкиСЛогом("ОбработкаСОшибкой");
	СтатусыИсполненияТеста = ЮТФабрика.СтатусыИсполненияТеста();
	
	ЮТест.ОжидаетЧто(Прогон.Лог, "Лог прогона тестов с ошибкой в обработчике события")
		.Содержит("[ERR]: Ошибка обработки события")
		.Содержит("Текст ошибки")
		.НеСодержит("Пропуск теста");
	
	ЮТест.ОжидаетЧто(Прогон.Набор, "Статус теста при ошибке в обработчике события")
		.Заполнено()
		.Свойство("Тесты[0].Статус").Равно(СтатусыИсполненияТеста.Сломан);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет тесты временной обработки с включенным логированием в файл и возвращает лог и результат прогона.
// После вложенного прогона (в том числе при исключении) восстанавливает контекст исполнения текущего теста
// и контекст логирования (по образцу см. ВыполнитьТестыВременнойОбработки).
//
// Параметры:
//  ВидОбработки - Строка - имя функции, формирующей временную обработку (ОбработкаСПропуском, ОбработкаСОшибкой)
//
// Возвращаемое значение:
//  Структура:
//  * Лог - Строка - текст лога прогона
//  * Набор - см. ЮТФабрика.ОписаниеИсполняемогоНабораТестов - набор с результатами исполнения
Функция ВыполнитьТестыОбработкиСЛогом(ВидОбработки)
	
	ТестовыйМодуль = ЮТест.ОписаниеТекущегоТестовогоМодуля();
	Набор = ЮТест.ОписаниеТекущегоТестовогоНабора();
	Тест = ЮТест.ОписаниеТекущегоТеста();
	
	СтарыеПараметры = ЮТКонтекстСлужебный.ЗначениеКонтекста("КонтекстЛогирования");
	ИмяФайлаЛога = УстановитьКонтекстЛогирования();
	
	Попытка
		Наборы = ВыполнитьТестыОбработки(ВидОбработки);
	Исключение
		ЮТКонтекстСлужебный.УстановитьЗначениеКонтекста("КонтекстЛогирования", СтарыеПараметры);
		ЮТСобытияСлужебный.ПередКаждымТестом(ОМ_ВыполнениеТестовОбработки, ТестовыйМодуль, Набор, Тест);
		ВызватьИсключение ИнформацияОбОшибке();
	КонецПопытки;
	
	ТекстЛога = "";
	Если ЮТФайлы.Существует(ИмяФайлаЛога) Тогда
		ТекстЛога = ЮТФайлы.ДанныеТекстовогоФайла(ИмяФайлаЛога);
	КонецЕсли;
	
	ЮТКонтекстСлужебный.УстановитьЗначениеКонтекста("КонтекстЛогирования", СтарыеПараметры);
	Попытка
		ЮТФайлы.УдалитьВременныеФайлы(ЮТКоллекции.ЗначениеВМассиве(ИмяФайлаЛога));
	Исключение
		// Нет действий по требованию линтера
	КонецПопытки;
	
	ЮТСобытияСлужебный.ПередКаждымТестом(ОМ_ВыполнениеТестовОбработки, ТестовыйМодуль, Набор, Тест);
	
	Возврат Новый Структура("Лог, Набор", ТекстЛога, Наборы[0]);
	
КонецФункции

// Подменяет контекст логирования: вывод во временный файл, без консоли.
//
// Возвращаемое значение:
//  Строка - имя временного файла лога
Функция УстановитьКонтекстЛогирования()
	
	ИмяФайлаЛога = ПолучитьИмяВременногоФайла("log");
	
	КонтекстЛогирования = Новый Структура();
	КонтекстЛогирования.Вставить("Включено", Истина);
	КонтекстЛогирования.Вставить("ФайлЛога", ИмяФайлаЛога);
	КонтекстЛогирования.Вставить("ВыводВКонсоль", Ложь);
	КонтекстЛогирования.Вставить("ФайлЛогаДоступенНаСервере", Истина);
	КонтекстЛогирования.Вставить("НакопленныеЗаписи", Новый Массив());
	КонтекстЛогирования.Вставить("ОбщееКоличествоТестов", 1);
	КонтекстЛогирования.Вставить("КоличествоВыполненныхТестов", 0);
	КонтекстЛогирования.Вставить("УровеньЛога", 0);
	ЮТКонтекстСлужебный.УстановитьЗначениеКонтекста("КонтекстЛогирования", КонтекстЛогирования);
	
	Возврат ИмяФайлаЛога;
	
КонецФункции

// Выполняет тесты временной обработки заданного вида и возвращает наборы с результатами.
//
// Параметры:
//  ВидОбработки - Строка - имя функции, формирующей временную обработку
//
// Возвращаемое значение:
//  Массив из см. ЮТФабрика.ОписаниеИсполняемогоНабораТестов
Функция ВыполнитьТестыОбработки(ВидОбработки)
	
	Сценарии = СценарииОбработки(ВидОбработки);
	ИсполняемыеСценарии = ЮТИсполнительСлужебныйКлиентСервер.ИсполняемыйТестовыйМодуль(Сценарии);
	
	Возврат ЮТИсполнительСлужебныйКлиентСервер.ВыполнитьГруппуНаборовТестов(ИсполняемыеСценарии.НаборыТестов, ИсполняемыеСценарии);
	
КонецФункции

// Возвращает сценарии временной обработки заданного вида.
//
// Параметры:
//  ВидОбработки - Строка - имя функции, формирующей временную обработку (ОбработкаСПропуском, ОбработкаСОшибкой)
//
// Возвращаемое значение:
//  см. ЮТИсполнительСлужебныйКлиентСервер.СценарииВнешнейОбработки
Функция СценарииОбработки(ВидОбработки = "Обработка")
	
	ИмяОбработки = ИмяОбработкиПоВиду(ВидОбработки);
	ЮТФильтрацияСлужебный.УстановитьКонтекст(Новый Структура("filter", Новый Структура));
	
	ОписаниеМодуля = Новый Структура("Сервер, КлиентУправляемое, КлиентОбычное", Истина, Ложь, Ложь);
	Возврат ЮТИсполнительСлужебныйКлиентСервер.СценарииВнешнейОбработки(ИмяОбработки, ОписаниеМодуля);
	
КонецФункции

// Подключает временную обработку заданного вида.
//
// Параметры:
//  ВидОбработки - Строка - имя функции, формирующей временную обработку
//
// Возвращаемое значение:
//  Строка - имя подключенной внешней обработки
Функция ИмяОбработкиПоВиду(ВидОбработки)
	
	Если ВидОбработки = "ОбработкаСПропуском" Тогда
		Возврат ОбработкаСПропуском();
	ИначеЕсли ВидОбработки = "ОбработкаСОшибкой" Тогда
		Возврат ОбработкаСОшибкой();
	Иначе
		Возврат Обработка();
	КонецЕсли;
	
КонецФункции

Функция Обработка()
	
	Текст =
	"Процедура ИсполняемыеСценарии() Экспорт
	|
	|	ЮТТесты
	|		.ДобавитьТест(""ТестУспешно"")
	|		.ДобавитьТест(""ТестОшибка"")
	|		.ДобавитьТест(""ТестСломан"")
	|	;
	|
	|КонецПроцедуры
	|
	|Процедура ТестУспешно() Экспорт
	|	ЮТест.ОжидаетЧто(1).Равно(1);
	|КонецПроцедуры
	|
	|Процедура ТестОшибка() Экспорт
	|	ЮТест.ОжидаетЧто(1).Равно(2);
	|КонецПроцедуры
	|
	|Процедура ТестСломан() Экспорт
	|	ЮТест.ОжидаетЧто(1).ОтсутствующийМетод(2);
	|КонецПроцедуры
	|";
	
	Возврат СкомпилироватьОбработку(Текст, "ОМ_ВыполнениеТестовОбработки");
	
КонецФункции

// Временная обработка: обработчик события `ПередКаждымТестом` пропускает тест (см. issue #709).
Функция ОбработкаСПропуском()
	
	Текст =
	"Процедура ИсполняемыеСценарии() Экспорт
	|
	|	ЮТТесты
	|		.ДобавитьТест(""ТестУспешно"")
	|	;
	|
	|КонецПроцедуры
	|
	|Процедура ПередКаждымТестом() Экспорт
	|	ЮТест.Пропустить(""Причина пропуска"");
	|КонецПроцедуры
	|
	|Процедура ТестУспешно() Экспорт
	|	ЮТест.ОжидаетЧто(1).Равно(1);
	|КонецПроцедуры
	|";
	
	Возврат СкомпилироватьОбработку(Текст, "ОМ_ВыполнениеТестовОбработки_Пропуск");
	
КонецФункции

// Временная обработка: обработчик события `ПередКаждымТестом` бросает обычное исключение.
Функция ОбработкаСОшибкой()
	
	Текст =
	"Процедура ИсполняемыеСценарии() Экспорт
	|
	|	ЮТТесты
	|		.ДобавитьТест(""ТестУспешно"")
	|	;
	|
	|КонецПроцедуры
	|
	|Процедура ПередКаждымТестом() Экспорт
	|	ВызватьИсключение ""Текст ошибки"";
	|КонецПроцедуры
	|
	|Процедура ТестУспешно() Экспорт
	|	ЮТест.ОжидаетЧто(1).Равно(1);
	|КонецПроцедуры
	|";
	
	Возврат СкомпилироватьОбработку(Текст, "ОМ_ВыполнениеТестовОбработки_Ошибка");
	
КонецФункции

// Компилирует и подключает внешнюю обработку с заданным текстом модуля.
//
// Параметры:
//  Текст - Строка - текст модуля обработки
//  Имя - Строка - имя подключаемой обработки
//
// Возвращаемое значение:
//  Строка - имя подключенной внешней обработки
Функция СкомпилироватьОбработку(Текст, Имя)
	
	Данные = ЮТВнешниеОбработкиСлужебныйСервер.СкомпилироватьВнешнююОбработку(Текст, Текст, Текст);
	
	Возврат ВнешниеОбработки.Подключить(ПоместитьВоВременноеХранилище(Данные), Имя);
	
КонецФункции

// Формирует ошибку пропуска теста, аналогичную вызову ЮТест.Пропустить() в обработчике события.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке
Функция ОшибкаПропускаТеста()
	
	Попытка
		ЮТРегистрацияОшибокСлужебный.Пропустить("Пропуск в обработчике события");
