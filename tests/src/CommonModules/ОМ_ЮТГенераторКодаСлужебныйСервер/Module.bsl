Процедура СформироватьКодДвиженийВФрматеMarkdown_ОдинРегистр() Экспорт
	
	Документ = ЮТест.Данные().КонструкторОбъекта("Документ.УстановкаЦен")
		.ТабличнаяЧасть("Цены")
			.ДобавитьСтроку()
			.Установить("Цена", 100)
			.Установить("ВидЦены", Справочники.ВидыЦен.Закупочная)
			.ФикцияРеквизитов("Товар")
		.Провести();
	
	ДанныеДвижений = Новый Соответствие;
	ДанныеДвижений.Вставить("РегистрСведений.ЦеныТоваров", ЮТЗапросы.ДвиженияДокумента(Документ, "РегистрСведений.ЦеныТоваров"));
	
	Результат = ЮТГенераторКодаСлужебныйСервер.СформироватьКодДвиженийВФрматеMarkdown(Документ, ДанныеДвижений);
	
	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Строка")
		.Заполнено()
		.Содержит("ПараметрыЗагрузки = ЮТест.Данные().ПараметрыЗагрузкиМакетов();")
		.Содержит("ДокументСсылка = ЮТест.Данные().СоздатьДокумент(""Документы.УстановкаЦен"");")
		.Содержит("ЮТест.Данные().ЗагрузитьДвиженияИзМакета(ДокументСсылка, ""РегистрСведений.ЦеныТоваров"", ДанныеТаблицы, ,ПараметрыЗагрузки);")
		.Содержит("// Движения по регистру РегистрСведений.ЦеныТоваров");
	
	// Проверяем наличие Markdown таблицы
	ЮТест.ОжидаетЧто(Результат)
		.Содержит("ДанныеТаблицы = ")
		.Содержит("|");
	
