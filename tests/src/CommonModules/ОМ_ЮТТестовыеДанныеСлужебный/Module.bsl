#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	КодТовара = ЮТОбщий.ЧислоВСтроку(ЮТест.Данные().СлучайноеПоложительноеЧисло(999999999));
	Период = ТекущаяДата();
	
	ЮТТесты.Тег("ТестовыеДанные").УдалениеТестовыхДанных()
		.ДобавитьТест("Фикция")
			.СПараметрами(Новый ОписаниеТипов("Число"))
			.СПараметрами(Новый ОписаниеТипов("Строка"))
			.СПараметрами(Новый ОписаниеТипов("Дата"))
			.СПараметрами(Новый ОписаниеТипов("Булево"))
			.СПараметрами(Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(3, 2, ДопустимыйЗнак.Неотрицательный)))
			.СПараметрами(Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(3)))
			.СПараметрами(Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Время)))
			.СПараметрами(Новый ОписаниеТипов("СправочникСсылка.Банки"))
			.СПараметрами(Новый ОписаниеТипов("ДокументСсылка.Заказ"))
			.СПараметрами(Новый ОписаниеТипов("ПеречислениеСсылка.СостоянияЗаказов"))
			.СПараметрами(Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыХарактеристик"))
			.СПараметрами(Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыХарактеристик, СправочникСсылка.Банки, ПеречислениеСсылка.СостоянияЗаказов"))
			.СПараметрами(Новый ОписаниеТипов("ВидДвиженияНакопления"))
		.ДобавитьТест("УдалениеТестовыхДанныхСправочник")
			.СПараметрами(КодТовара)
			.СПараметрами(КодТовара)
		.ДобавитьТест("УдалениеТестовыхДанныхДокумент")
			.СПараметрами(КодТовара)
			.СПараметрами(КодТовара)
		.ДобавитьТест("УдалениеТестовыхДанныхРегистрСведений")
			.СПараметрами(Период)
			.СПараметрами(Период)
		.ДобавитьТест("УдалениеТестовыхДанныхВызовСервера")
		// Событийные тесты - каждый в своем наборе (последним в модуле): буфер уровня набора общий для набора,
		// очистка срабатывает один раз на набор; несколько событийных тестов в одном наборе перезаписывали бы
		// режим перехвата друг друга (последний тест побеждал бы). Sticky-маркеры (`ПроверкаСобытия` и др.)
		// не сбрасываются в `ПередКаждимТестом` - сбрасываются только в `ПередВсемиТестами`.
		.ДобавитьСерверныйТест("УдалениеТестовыхДанныхСобытием");
	
	ЮТТесты.ДобавитьТестовыйНабор("УдалениеТестовыхДанныхИсключениемИзКоллекции", "ТестовыеДанные")
		.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("УдалениеТестовыхДанныхИсключениемИзКоллекции");
	
	ЮТТесты.ДобавитьТестовыйНабор("СобытиеПередУдалением_ОшибкаОбработчика", "ТестовыеДанные")
		.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("СобытиеПередУдалением_ОшибкаОбработчика");
	
	ЮТТесты.ДобавитьТестовыйНабор("СобытиеПередУдалением_ПустойБуферИВыключеннаяНастройка", "ТестовыеДанные")
		.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("СобытиеПередУдалением_ПустойБуфер")
		.ДобавитьСерверныйТест("СобытиеПередУдалением_ВыключеннаяНастройка")
		// Настройка применения: `УстановитьНастройкуИсполнения` пишет в последний добавленный тест
		// (`ТекущийЭлемент`), поэтому вызовы настроек - строго ПОСЛЕ `ДобавитьСерверныйТест`.
		// Транзакция отключается: иначе объект "переживал" бы прогон откатом транзакции,
		// а не выключенной настройкой удаления (маскировка позитивного исхода).
		.УдалениеТестовыхДанных(Ложь)
		.ВТранзакции(Ложь);
	
	// Тесты геттера и взаимодействия - отдельным набором ПОСЛЕ событийных: событийный тест обязан быть
	// последним в своем наборе (режим перехвата сбрасывается `ПередКаждымТестом` последующих тестов набора,
	// и выстрел очистки уровня набора получил бы пустой режим вместо "Отмена"). Серверные инвокации отключают
	// транзакцию явно (глобальная настройка прогона - `ВТранзакции = Истина`), иначе буфер уровня теста не наполняется.
	ЮТТесты.ДобавитьТестовыйНабор("ЗарегистрированныеКУдалению_УровеньТестаИВзаимодействие", "ТестовыеДанные")
		.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("ЗарегистрированныеКУдалению_ТолькоУровеньТеста")
		.ВТранзакции(Ложь)
		.ДобавитьСерверныйТест("ВзаимодействиеГеттераИСобытия")
		.ВТранзакции(Ложь);
	
КонецПроцедуры

Процедура Фикция(ОписаниеТипа) Экспорт
	
	Результат = ЮТТестовыеДанныеСлужебный.Фикция(ОписаниеТипа);
	
	ЮТест.ОжидаетЧто(Результат)
		.Заполнено()
		.ИмеетТип(ОписаниеТипа);
	
КонецПроцедуры

Процедура УдалениеТестовыхДанныхСправочник(Код) Экспорт
	
	СоздатьСсылку("Тест", Код);
	
	Ссылки = ЮТест.Контекст().Значение("Ссылки");
	СсылкаСуществует(Ссылки.Набор, "Набор");
	
КонецПроцедуры

Процедура УдалениеТестовыхДанныхВызовСервера() Экспорт
	
	Ссылка = ПомощникТестированияВызовСервера.НовыйТовар();
	ЮТест.Контекст().Значение("Ссылки").Вставить("ТестВызовСервера", Ссылка);
	
КонецПроцедуры

Процедура УдалениеТестовыхДанныхСобытием() Экспорт
	
	// Проверка события `ПередУдалениемТестовыхДанных`: подписчик в режиме "Отмена" сбрасывает стандартную обработку,
	// и штатная очистка уровня не выполняется. Утверждения - в `ПослеВсехТестов`.
	// Событие стреляет на сервере при очистке буферов тестовых данных (серверные буферы уровней),
	// поэтому тест серверный, а отмена проверяется на данных уровня набора.
	// Маркер `ПроверкаСобытия` включает блок проверок события в `ПослеВсехТестов` серверного контекста:
	// без него регрессия (событие не стреляет) проходила бы незаметно в блоке обычных проверок.
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	Перехват.Режим = "Отмена";
	Перехват.ПроверкаСобытия = Истина;
	// Захватываем ссылку набора ДО очистки: объекты пересоздаются каждым набором,
	// к моменту `ПослеВсехТестов` в `Ссылки` останутся ссылки последнего набора.
	Перехват.Вставить("НаборОтмены", ЮТест.Контекст().Значение("Ссылки").Набор);

	
КонецПроцедуры

// Проверка события `ПередУдалениемТестовыхДанных`: подписчик в режиме "ИсключитьСсылки" удаляет ссылочные
// значения из коллекции события (эмуляция самостоятельного удаления), ключи записей остаются штатной очистке.
// Утверждения - в `ПослеВсехТестов` (блок `ПроверкаИсключения`).
// Как и в `УдалениеТестовыхДанныхСобытием`, исключение проверяется на смешанном буфере уровня набора
// (справочник + запись регистра), т.к. буфер уровня теста серверной группы не наполняется из-за транзакции.
Процедура УдалениеТестовыхДанныхИсключениемИзКоллекции() Экспорт
	
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	Перехват.Режим = "ИсключитьСсылки";
	Перехват.ПроверкаИсключения = Истина;
	// Захватываем ссылки уровня набора ДО очистки: объекты пересоздаются каждым набором, поэтому
	// к моменту `ПослеВсехТестов` в `Ссылки` останутся только ссылки последнего набора.
	Ссылки = ЮТест.Контекст().Значение("Ссылки");
	Перехват.Вставить("НаборИсключения", Ссылки.Набор);
	Перехват.Вставить("ВалютаИсключения", Ссылки.ВалютаНабора);
	// Позитивный контроль: запись набора еще жива (очистка уровня набора выполняется ПОСЛЕ обработчиков
	// тестового модуля). Без него негативный ассерт `НеСодержитЗаписи` в `ПослеВсехТестов` был бы вакуумным.
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.КурсыВалют", "Запись регистра уровня набора создана")
		.СодержитЗаписи(ЮТест.Предикат().Реквизит("Валюта").Равно(Ссылки.ВалютаНабора));
	
КонецПроцедуры

// Проверка события `ПередУдалениемТестовыхДанных`: ошибка в обработчике не роняет прогон,
// логируется, штатная очистка выполняется. Утверждения - в `ПослеВсехТестов` (блок `ПроверкаОшибки`).
Процедура СобытиеПередУдалением_ОшибкаОбработчика() Экспорт
	
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	Перехват.Режим = "Ошибка";
	Перехват.ПроверкаОшибки = Истина;
	Перехват.Вставить("НаборОшибки", ЮТест.Контекст().Значение("Ссылки").Набор);
	Перехват.Вставить("ВалютаОшибки", ЮТест.Контекст().Значение("Ссылки").ВалютаНабора);
	// Позитивный контроль: запись набора еще жива (см. `УдалениеТестовыхДанныхИсключениемИзКоллекции`).
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.КурсыВалют", "Запись регистра уровня набора создана")
		.СодержитЗаписи(ЮТест.Предикат().Реквизит("Валюта").Равно(ЮТест.Контекст().Значение("Ссылки").ВалютаНабора));
	
КонецПроцедуры

// Проверка guard'а движка: событие не стреляет на пустом буфере уровня (данные уровня теста не созданы,
// буфер уровня набора уже очищен предыдущими наборами серверной группы). Утверждения - в `ПослеВсехТестов`
// (блок `ПроверкаПустогоБуфера`): все зафиксированные выстрелы имели непустые коллекции.
Процедура СобытиеПередУдалением_ПустойБуфер() Экспорт
	
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	Перехват.Режим = "";
	Перехват.Вставить("ПроверкаПустогоБуфера", Истина);
	
КонецПроцедуры

// Проверка настройки исполнения: `.УдалениеТестовыхДанных(Ложь)` отключает авто-удаление для теста -
// регистрации в буфер не выполняются, событие не стреляет, объекты остаются. Утверждения - в
// `ПослеВсехТестов` (блок `ПроверкаВыключеннойНастройки`).
Процедура СобытиеПередУдалением_ВыключеннаяНастройка() Экспорт
	
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	Перехват.Режим = "";
	Перехват.Вставить("ПроверкаВыключеннойНастройки", Истина);
	
	// Код - случайный (уникальность кода справочника): объект переживает прогон (никто его не удаляет -
	// авто-удаление отключено), фиксированный код конфликтовал бы при повторных прогонах.
	Код = ЮТОбщий.ЧислоВСтроку(ЮТест.Данные().СлучайноеПоложительноеЧисло(999999999));
	Ссылка = ЮТест.Данные().КонструкторОбъекта("Справочники.Товары")
		.Установить("Наименование", "Выключенная настройка")
		.Установить("Код", Код)
		.Записать();
	Перехват.Вставить("ОбъектВыключеннойНастройки", Ссылка);
	Перехват.Вставить("ВалютаВыключеннойНастройки", ЮТест.Данные().СоздатьЭлемент("Справочники.Валюты"));
	
	// Геттер при выключенной настройке ничего не возвращает: регистрации не выполнялись.
	Изъятые = ЮТест.Данные().ЗарегистрированныеКУдалению();
	ЮТест.ОжидаетЧто(Изъятые, "Геттер при выключенной настройке возвращает пустой массив")
		.ИмеетДлину(0);
	
КонецПроцедуры


// Тест уровневой семантики геттера `ЗарегистрированныеКУдалению`: возвращает только ссылки уровня теста,
// созданные в теле; ссылка уровня набора (создана `ПередТестовымНабором`) недоступна из тела теста.
// Дополнительно проверяется самостоятельное удаление изъятого - авто-очистка уровня теста не падает на пустом буфере.
Процедура ЗарегистрированныеКУдалению_ТолькоУровеньТеста() Экспорт
	
	Товар = ЮТест.Данные().СоздатьЭлемент("Справочники.Товары");
	
	Изъятые = ЮТест.Данные().ЗарегистрированныеКУдалению();
	
	ЮТест.ОжидаетЧто(Изъятые, "Геттер изъял только ссылки уровня теста")
		.ИмеетДлину(1)
		.Содержит(Товар)
		.НеСодержит(ЮТест.Контекст().Значение("Ссылки").Набор);
	
	// Самостоятельное удаление изъятого: авто-очистка уровня теста получит пустой буфер и не упадет.
	ЮТест.Данные().Удалить(Изъятые);
	
КонецПроцедуры

// Тест взаимодействия геттера и события (варианты A+B): геттер изымает ссылку справочника из буфера
// уровня теста и тест удаляет ее сам; ключ записи регистра остается в буфере - событие получает его
// при очистке уровня теста, штатная очистка удаляет запись. Утверждения - в `ПослеВсехТестов` (блок
// `ВзаимодействиеГеттераИСобытия`).
Процедура ВзаимодействиеГеттераИСобытия() Экспорт
	
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	Перехват.Режим = ""; // Подписчик только фиксирует вызовы.
	Перехват.Вставить("ПроверкаВзаимодействия", Истина);
	
	Валюта = ЮТест.Данные().СоздатьЭлемент("Справочники.Валюты");
	Период = ТекущаяДата(); // BSLLS:DeprecatedCurrentDate-off
	Курс = ЮТест.Данные().СлучайноеПоложительноеЧисло(99999);
	ЮТест.Данные().КонструкторОбъекта("РегистрыСведений.КурсыВалют")
		.Установить("Валюта", Валюта)
		.Установить("Курс", Курс)
		.Установить("Период", Период)
		.Записать();
	Товар = ЮТест.Данные().СоздатьЭлемент("Справочники.Товары");
	
	Изъятые = ЮТест.Данные().ЗарегистрированныеКУдалению();
	
	ЮТест.ОжидаетЧто(Изъятые, "Изъяты ссылки уровня теста (Товар и Валюта)")
		.Содержит(Товар)
		.Содержит(Валюта);
	
	ЮТест.Данные().Удалить(Изъятые); // Самостоятельное удаление изъятых ссылок
	
	Перехват.Вставить("ТоварВзаимодействия", Товар);
	Перехват.Вставить("ВалютаВзаимодействия", Валюта);
	
КонецПроцедуры


Процедура УдалениеТестовыхДанныхДокумент(НомерДокумента) Экспорт
	
	ЮТест.Данные().КонструкторОбъекта("Документы.ПриходТовара")
		.Установить("Номер", НомерДокумента)
		.Провести();
	
КонецПроцедуры

Процедура УдалениеТестовыхДанныхРегистрСведений(Период) Экспорт
	
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.КурсыВалют")
		.НеСодержитЗаписи(ЮТест.Предикат()
			.Реквизит("Период").Равно(Период));
	Курс = ЮТест.Данные().СлучайноеПоложительноеЧисло(99999);
	ЮТест.Данные().КонструкторОбъекта("РегистрыСведений.КурсыВалют")
		.Фикция("Валюта")
		.Установить("Курс", Курс)
		.Установить("Период", Период)
		.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПередВсемиТестами() Экспорт
	
	Ссылки = Новый Структура("Набор, Тест");
	ЮТест.Контекст().УстановитьЗначение("Ссылки", Ссылки);
	СоздатьСсылку("Модуль", "Модуль"); // Если данные созданные в этом событии не удаляются то прогон в другом контексте долже упасть (на сервере)
	
	Перехват = Новый Структура("Режим, Вызвано, ПроверкаСобытия, ПроверкаИсключения, ПроверкаОшибки");
	Перехват.Вызвано = Ложь;
	Перехват.ПроверкаСобытия = Ложь;
	Перехват.ПроверкаИсключения = Ложь;
	Перехват.ПроверкаОшибки = Ложь;
	ЮТест.Контекст().УстановитьЗначение("ПерехватУдаления", Перехват);
	
КонецПроцедуры

Процедура ПередКаждымТестом() Экспорт
	
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	Перехват.Режим = "";
	Перехват.Вызвано = Ложь;
	// Маркеры `ПроверкаСобытия`/`ПроверкаИсключения`/`ПроверкаОшибки` сознательно НЕ сбрасываются
	// (см. комментарий у регистрации тестов): маркеры sticky, сбрасываются только в `ПередВсемиТестами`.
	
КонецПроцедуры

Процедура ПередТестовымНабором() Экспорт
	
	СоздатьСсылку("Набор");
	// Смешанный буфер набора для событийных тестов: справочник (ссылка) + запись регистра (ключ записи).
	// Валюта создается явно и сохраняется в контекст - это уникальный идентификатор записи набора
	// в `КурсыВалют` (ключ регистра = Валюта + Период, а периодичность регистра - День, поэтому
	// Период не различает наборы в рамках одного прогона).
	Валюта = ЮТест.Данные().СоздатьЭлемент("Справочники.Валюты");
	Период = ТекущаяДата(); // BSLLS:DeprecatedCurrentDate-off
	Курс = ЮТест.Данные().СлучайноеПоложительноеЧисло(99999);
	ЮТест.Данные().КонструкторОбъекта("РегистрыСведений.КурсыВалют")
		.Установить("Валюта", Валюта)
		.Установить("Курс", Курс)
		.Установить("Период", Период)
		.Записать();
	ЮТест.Контекст().Значение("Ссылки").Вставить("ВалютаНабора", Валюта);
	
КонецПроцедуры

Процедура ПослеТестовогоНабора() Экспорт
	
	// Утверждения об удалении данных уровня набора здесь невозможны: обработчики тестового модуля
	// выполняются до очистки буферов движком (`ЮТТестовыеДанныеСлужебный.ПослеТестовогоНабора`
	// подписан на то же событие и вызывается в той же цепочке). Проверки - в `ПослеВсехТестов`.
	
КонецПроцедуры

Процедура ПослеВсехТестов() Экспорт
	
	Ссылки = ЮТест.Контекст().Значение("Ссылки");
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	
	Если НЕ (Перехват.ПроверкаСобытия ИЛИ Перехват.ПроверкаИсключения ИЛИ Перехват.ПроверкаОшибки) Тогда
		// Штатная очистка уровней (без вмешательства события): все данные должны быть удалены.
		СсылкаНеСуществует(Ссылки.Набор, "Набор");
		Если Ссылки.Свойство("Тест") И Ссылки.Тест <> Неопределено Тогда
			СсылкаНеСуществует(Ссылки.Тест, "Тест");
		КонецЕсли;
		Если Ссылки.Свойство("ТестВызовСервера") Тогда
			СсылкаНеСуществует(Ссылки.ТестВызовСервера, "ТестВызовСервера");
		КонецЕсли;
	Иначе
		// Общая проверка для событийных наборов: все выстрелы события зафиксированы в несбрасываемом логе
		// `Перехват.Вызовы` (режим на момент выстрела + копия коллекции).
		ЮТест.ОжидаетЧто(Перехват.Вызвано, "Событие ПередУдалениемТестовыхДанных вызвано").ЭтоИстина();
		ЮТест.ОжидаетЧто(Перехват.Вызовы, "Несбрасываемый лог вызовов события").Заполнено();
	КонецЕсли;
	
	Если Перехват.Свойство("ПроверкаПустогоБуфера") Тогда
		// Тест `СобытиеПередУдалением_ПустойБуфер`: все выстрелы события за прогон были с непустыми коллекциями
		// (guard движка: пустой буфер уровня не порождает вызова). Проверяется ПЕРВЫМ из событийных блоков:
		// снятый guard искажает и одноразовую отмену (первый пустой выстрел потребляет режим) - падение
		// на этом блоке точно указывает на мутацию guard'а, а не на каскадный эффект.
		ЮТест.ОжидаетЧто(Перехват.Вызовы, "Лог вызовов события").Заполнено();
		Для Каждого Выстрел Из Перехват.Вызовы Цикл
			ЮТест.ОжидаетЧто(Выстрел.Коллекция, "Guard: выстрел только по непустому буферу")
				.Заполнено();
		КонецЦикла;
	КонецЕсли;
	
	Если Перехват.ПроверкаСобытия Тогда
		// Тест `УдалениеТестовыхДанныхСобытием` (основной набор, режим "Отмена"): штатное удаление уровня набора
		// отменено - объект набора сохраняется. Данные уровня теста (созданы в теле `УдалениеТестовыхДанных`)
		// уже удалены очисткой уровня теста - она была выполнена до отмены (отмена одноразовая).
		РежимОтмены = ВыстрелПоОбъекту(Перехват.Вызовы, Перехват.НаборОтмены, "Отмена");
		ЮТест.ОжидаетЧто(РежимОтмены, "Выстрел события с объектом набора теста `УдалениеТестовыхДанныхСобытием`")
			.НеРавно(Неопределено);
		ЮТест.ОжидаетЧто(РежимОтмены.Режим, "Режим перехвата при выстреле уровня набора основного набора")
			.Равно("Отмена");
		// Документирующая избыточность: повторяет критерий поиска, но фиксирует состав коллекции события.
		ЮТест.ОжидаетЧто(РежимОтмены.Коллекция, "Буфер выстрела содержал объект набора")
			.Содержит(Перехват.НаборОтмены);
		СсылкаСуществует(Перехват.НаборОтмены, "Штатная очистка отменена подписчиком: объект набора сохранен");
	КонецЕсли;
	
	Если Перехват.ПроверкаИсключения Тогда
		// Тест `УдалениеТестовыхДанныхИсключениемИзКоллекции`: подписчик исключил ссылки из коллекции события
		// (эмуляция самостоятельного удаления), ключ записи регистра остался штатной очистке.
		Выстрел = ВыстрелПоОбъекту(Перехват.Вызовы, Перехват.НаборИсключения, "ИсключитьСсылки");
		ЮТест.ОжидаетЧто(Выстрел, "Выстрел события с объектом набора теста `УдалениеТестовыхДанныхИсключениемИзКоллекции`")
			.НеРавно(Неопределено);
		ЮТест.ОжидаетЧто(Выстрел.Режим, "Режим перехвата при выстреле").Равно("ИсключитьСсылки");
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.КурсыВалют", "Запись регистра уровня набора удалена штатной очисткой")
		.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Валюта").Равно(Перехват.ВалютаИсключения));
		СсылкаСуществует(Перехват.НаборИсключения, "Ссылка набора исключена из удаления");
	КонецЕсли;
	
	Если Перехват.ПроверкаОшибки Тогда
		// Тест `СобытиеПередУдалением_ОшибкаОбработчика`: ошибка обработчика не роняет прогон,
		// штатная очистка выполняется (мутаций коллекции не было).
		Выстрел = ВыстрелПоОбъекту(Перехват.Вызовы, Перехват.НаборОшибки, "Ошибка");
		ЮТест.ОжидаетЧто(Выстрел, "Выстрел события с объектом набора теста `СобытиеПередУдалением_ОшибкаОбработчика`")
			.НеРавно(Неопределено);
		ЮТест.ОжидаетЧто(Выстрел.Режим, "Режим перехвата при выстреле").Равно("Ошибка");
		СсылкаНеСуществует(Перехват.НаборОшибки, "Объект удален штатной очисткой несмотря на ошибку обработчика");
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.КурсыВалют", "Запись регистра уровня набора удалена штатной очисткой")
		.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Валюта").Равно(Перехват.ВалютаОшибки));
	КонецЕсли;
	
	
	Если Перехват.Свойство("ПроверкаВыключеннойНастройки") Тогда
		// Тест `СобытиеПередУдалением_ВыключеннаяНастройка`: авто-удаление отключено настройкой исполнения теста -
		// объекты не зарегистрированы и не удалены (ни событием, ни штатной очисткой).
		СсылкаСуществует(Перехват.ОбъектВыключеннойНастройки, "Объект сохранен: авто-удаление отключено настройкой");
		ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.Валюты", "Валюта сохранена: авто-удаление отключено настройкой")
			.СодержитЗаписи(ЮТест.Предикат().Реквизит("Ссылка").Равно(Перехват.ВалютаВыключеннойНастройки));
		// Зачистка за собой: объекты переживают прогон (проверяемое поведение), удаляем вручную,
		// чтобы не накапливать мусор в информационной базе между прогонами.
		ЮТест.Данные().Удалить(ЮТКоллекции.ЗначениеВМассиве(Перехват.ОбъектВыключеннойНастройки, Перехват.ВалютаВыключеннойНастройки));
	КонецЕсли;
	
	Если Перехват.Свойство("ПроверкаВзаимодействия") Тогда
		// Тест `ВзаимодействиеГеттераИСобытия`: изъятые геттером ссылки удалены вручную - их нет в базе
		// и их не было в коллекциях события (геттер изъял до очистки уровня теста); ключ записи регистра
		// остался фреймворку и удален штатной очисткой (записи нет).
		ЮТест.ОжидаетЧто(Перехват.Вызовы, "Событие вызвано при очистке уровней").Заполнено();
		Для Каждого Выстрел Из Перехват.Вызовы Цикл
			ЮТест.ОжидаетЧто(Выстрел.Коллекция, "Изъятые геттером ссылки не попали ни в один выстрел")
				.НеСодержит(Перехват.ТоварВзаимодействия)
				.НеСодержит(Перехват.ВалютаВзаимодействия);
		КонецЦикла;
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.КурсыВалют", "Запись регистра удалена штатной очисткой")
			.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Валюта").Равно(Перехват.ВалютаВзаимодействия));
		СсылкаНеСуществует(Перехват.ТоварВзаимодействия, "Товар удален вручную и не восстановлен");
		// Валюта - не Товар: хелпер `СсылкаНеСуществует` проверяет тип `СправочникСсылка.Товары`, проверяем напрямую.
		ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.Валюты", "Валюта удалена вручную и не восстановлена")
			.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Ссылка").Равно(Перехват.ВалютаВзаимодействия));
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьСсылку(ИмяПеременной, Знач Код = Неопределено)
	
	Если Код = Неопределено Тогда
		Код = ЮТОбщий.ЧислоВСтроку(ЮТест.Данные().СлучайноеПоложительноеЧисло(999999999));
	КонецЕсли;
	
	Ссылка = ЮТест.Данные().КонструкторОбъекта("Справочники.Товары")
		.Установить("Наименование", Код)
		.Установить("Код", Код)
		.Записать();
	ЮТест.Контекст().Значение("Ссылки").Вставить(ИмяПеременной, Ссылка);
	
КонецПроцедуры

// Ищет в несбрасываемом логе вызовов события выстрел, чья коллекция содержит указанный объект
// (и, при указании, с нужным режимом перехвата - один и тот же объект может встретиться в выстрелах
// нескольких уровней/тестов, а нужен конкретный).
//
// Параметры:
//  Вызовы - Массив из Структура - см. `ПерехватУдаленияТестовыхДанных.ПередУдалениемТестовыхДанных`
//  Объект - СправочникСсылка - искомый объект тестовых данных
//  Режим - Строка - требуемый режим перехвата снимка, "*" - любой
//
// Возвращаемое значение:
//  Структура, Неопределено - снимок вызова ("Режим", "Коллекция") или Неопределено, если объект не найден
Функция ВыстрелПоОбъекту(Вызовы, Объект, Режим = "*")
	
	Для Каждого Выстрел Из Вызовы Цикл
		Если (Режим = "*" ИЛИ Выстрел.Режим = Режим) И Выстрел.Коллекция.Найти(Объект) <> Неопределено Тогда
			Возврат Выстрел;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура СсылкаСуществует(Ссылка, Описание)
	
	ЮТест.ОжидаетЧто(Ссылка, Описание).ИмеетТип("СправочникСсылка.Товары");
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.Товары", Описание).СодержитЗаписи(ЮТест.Предикат().Реквизит("Ссылка").Равно(Ссылка));
	
КонецПроцедуры

Процедура СсылкаНеСуществует(Ссылка, Описание)
	
	ЮТест.ОжидаетЧто(Ссылка, Описание).ИмеетТип("СправочникСсылка.Товары");
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.Товары", Описание).НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Ссылка").Равно(Ссылка));
	
КонецПроцедуры

#КонецОбласти
