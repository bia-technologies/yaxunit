#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	Статусы = ЮТФабрика.СтатусыИсполненияТеста();
	
	ЮТТесты
		.ДобавитьТест("ПараметрыГенерацииОтчета")
		.ДобавитьТест("СтатусОтчета_ВсеСтатусы")
			.СПараметрами(Статусы.Успешно, "passed")
			.СПараметрами(Статусы.Ошибка, "failed")
			.СПараметрами(Статусы.Сломан, "failed")
			.СПараметрами(Статусы.НеРеализован, "skipped")
			.СПараметрами(Статусы.Пропущен, "skipped")
			.СПараметрами(Статусы.Ожидание, "skipped")
			.СПараметрами(Статусы.Исполнение, "other")
		.ДобавитьТест("ОписаниеТеста")
		.ДобавитьТест("Сводка")
		.ДобавитьТест("Сводка_ПустойПрогон")
		.ДобавитьТест("ТестыОтчета")
		.ДобавитьТест("ТестыОтчета_ОшибкиНабора")
		.ДобавитьТест("ТестыОтчета_ОшибкиМодуля")
		.ДобавитьТест("ДанныеОтчета")
		.ДобавитьТест("ДанныеОтчета_ПустойПрогон")
		.ДобавитьТест("ОписаниеТеста_ОшибкаБезСтека")
		.ДобавитьТест("ТестыОтчета_ОшибкаНабораБезСтека")
		.ДобавитьТест("ДанныеОтчета_ПолныйСоставДанных");
	
КонецПроцедуры

Процедура ПараметрыГенерацииОтчета() Экспорт
	
	Параметры = ЮТОтчетCTRFСлужебный.ПараметрыГенерацииОтчета();
	
	ЮТест.ОжидаетЧто(Параметры)
		.Свойство("Форматы")
		.ИмеетДлину(1)
		.ИмеетСвойство("ctrf");
	
	Формат = Параметры.Форматы.ctrf;
	ЮТест.ОжидаетЧто(Формат, "Описание формата ctrf")
		.Свойство("Идентификатор").Равно("ctrf")
		.Свойство("Представление").Равно("CTRF (json)")
		.Свойство("ИмяФайлаПоУмолчанию").Равно("ctrf-report.json")
		.Свойство("ФильтрВыбораФайла").Равно("CTRF (*.json)|*.json")
		.Свойство("СамостоятельнаяЗаписьОтчета").ЭтоЛожь();
	
КонецПроцедуры

// Тест табличного маппинга всех статусов исполнения в статусы CTRF
// см. Global Constraints плана issue #701:
//  Успешно→passed, Ошибка→failed, Сломан→failed, НеРеализован→skipped,
//  Пропущен→skipped, Ожидание→skipped, Исполнение→other
Процедура СтатусОтчета_ВсеСтатусы(Статус, ОжидаемыйСтатус) Экспорт
	
	СтатусОтчета = ЮТОтчетCTRFСлужебный.СтатусОтчета(Статус);
	
	ЮТест.ОжидаетЧто(СтатусОтчета, СтрШаблон("Статус отчета для статуса `%1`", Статус))
		.Равно(ОжидаемыйСтатус);
	
КонецПроцедуры

// Тест формирования описания теста для CTRF-отчета
Процедура ОписаниеТеста() Экспорт
	
	Статусы = ЮТФабрика.СтатусыИсполненияТеста();
	
	// Базовая проверка на заполненном успешном тесте
	Данные = НовыеТестовыеДанные(Статусы.Успешно);
	Описание = ЮТОтчетCTRFСлужебный.ОписаниеТеста(Данные.Тест, Данные.Набор, Данные.Модуль);
	
	ЮТест.ОжидаетЧто(Описание, "Описание успешного теста")
		.ИмеетТип("Соответствие")
		.Свойство("name").Равно("ТестовыйТестCTRF")
		.Свойство("status").Равно("passed")
		.Свойство("duration").Равно(500)
		.Свойство("start").Равно(1000)
		.Свойство("suite").ИмеетДлину(2)
		.Свойство("suite[0]").Равно("ТестовыйМодульCTRF")
		.Свойство("suite[1]").Равно("ТестовыйНаборCTRF")
		.НетСвойства("rawStatus")
		.НетСвойства("message")
		.НетСвойства("trace")
		.НетСвойства("tags");
	
	// Упавший тест: сообщение и стек первой ошибки
	Данные = НовыеТестовыеДанные(Статусы.Ошибка);
	Данные.Тест.Ошибки.Добавить(НовоеОписаниеОшибки("Сообщение об ошибке", "Стек ошибки 1"));
	Данные.Тест.Ошибки.Добавить(НовоеОписаниеОшибки("Вторая ошибка", "Стек ошибки 2"));
	Описание = ЮТОтчетCTRFСлужебный.ОписаниеТеста(Данные.Тест, Данные.Набор, Данные.Модуль);
	
	ЮТест.ОжидаетЧто(Описание, "Описание упавшего теста")
		.Свойство("status").Равно("failed")
		.Свойство("message").Равно("Сообщение об ошибке")
		.Свойство("trace").Равно("Стек ошибки 1")
		.НетСвойства("rawStatus");
	
	// Сломанный тест: failed + rawStatus (не 1:1 маппинг)
	Данные = НовыеТестовыеДанные(Статусы.Сломан);
	Данные.Тест.Ошибки.Добавить(НовоеОписаниеОшибки("Проверка провалена", "Стек сломанного"));
	Описание = ЮТОтчетCTRFСлужебный.ОписаниеТеста(Данные.Тест, Данные.Набор, Данные.Модуль);
	
	ЮТест.ОжидаетЧто(Описание, "Описание сломанного теста")
		.Свойство("status").Равно("failed")
		.Свойство("rawStatus").Равно("Сломан")
		.Свойство("message").Равно("Проверка провалена")
		.Свойство("trace").Равно("Стек сломанного");
	
	// НеРеализован: skipped + rawStatus
	Данные = НовыеТестовыеДанные(Статусы.НеРеализован);
	Описание = ЮТОтчетCTRFСлужебный.ОписаниеТеста(Данные.Тест, Данные.Набор, Данные.Модуль);
	
	ЮТест.ОжидаетЧто(Описание, "Описание нереализованного теста")
		.Свойство("status").Равно("skipped")
		.Свойство("rawStatus").Равно("НеРеализован")
		.НетСвойства("message")
		.НетСвойства("trace");
	
	// Теги модуля/набора/теста попадают в tags
	Данные = НовыеТестовыеДанные(Статусы.Успешно);
	Данные.Тест.Теги = ЮТКоллекции.ЗначениеВМассиве("ТегТеста");
	Данные.Набор.Теги = ЮТКоллекции.ЗначениеВМассиве("ТегНабора");
	Данные.Модуль.Теги = ЮТКоллекции.ЗначениеВМассиве("ТегМодуля");
	Описание = ЮТОтчетCTRFСлужебный.ОписаниеТеста(Данные.Тест, Данные.Набор, Данные.Модуль);
	
	ЮТест.ОжидаетЧто(Описание, "Описание теста с тегами")
		.Свойство("tags").ИмеетДлину(3)
		.Свойство("tags[0]").Равно("ТегМодуля")
		.Свойство("tags[1]").Равно("ТегНабора")
		.Свойство("tags[2]").Равно("ТегТеста");
	
КонецПроцедуры

// Тест формирования сводки по массиву записей тестов CTRF.
// Записи с разными start/duration, у части start = 0:
//  * passed, start = 1000, duration = 500 (окончание 1500)
//  * failed, start = 2000, duration = 100 (окончание 2100)
//  * skipped, start = 0 (без времени)
//  * other, start = 0 (без времени)
// Ожидание: start = 1000 (min ненулевых), stop = 2100 (max start + duration).
// Примечание: пример плана (start 1000/2000, duration 500/100 → stop=2500)
// противоречит формуле stop = max(start + duration); тест проверяет формулу.
Процедура Сводка() Экспорт
	
	Тесты = Новый Массив;
	Тесты.Добавить(НоваяЗаписьОтчета("passed", 1000, 500));
	Тесты.Добавить(НоваяЗаписьОтчета("failed", 2000, 100));
	Тесты.Добавить(НоваяЗаписьОтчета("skipped", 0, 10));
	Тесты.Добавить(НоваяЗаписьОтчета("other", 0, 20));
	
	Сводка = ЮТОтчетCTRFСлужебный.Сводка(Тесты);
	
	ЮТест.ОжидаетЧто(Сводка, "Сводка по четырем записям")
		.ИмеетТип("Соответствие")
		.Свойство("tests").Равно(4)
		.Свойство("passed").Равно(1)
		.Свойство("failed").Равно(1)
		.Свойство("skipped").Равно(1)
		.Свойство("other").Равно(1)
		.Свойство("pending").Равно(0)
		.Свойство("start").Равно(1000)
		.Свойство("stop").Равно(2100);
	
КонецПроцедуры

// Тест сводки для пустого прогона: все счётчики нули, start = 0, stop = 0.
Процедура Сводка_ПустойПрогон() Экспорт
	
	Сводка = ЮТОтчетCTRFСлужебный.Сводка(Новый Массив);
	
	ЮТест.ОжидаетЧто(Сводка, "Сводка пустого прогона")
		.Свойство("tests").Равно(0)
		.Свойство("passed").Равно(0)
		.Свойство("failed").Равно(0)
		.Свойство("pending").Равно(0)
		.Свойство("skipped").Равно(0)
		.Свойство("other").Равно(0)
		.Свойство("start").Равно(0)
		.Свойство("stop").Равно(0);
	
КонецПроцедуры

// Тест агрегации результатов выполнения в массив записей тестов CTRF.
// Один модуль, один набор, два теста с разными статусами и временами.
Процедура ТестыОтчета() Экспорт
	
	Статусы = ЮТФабрика.СтатусыИсполненияТеста();
	
	РезультатВыполнения = Новый Массив;
	Модуль = ТестовыеДанные.ОписаниеТестовогоМодуля("ТестовыйМодульCTRF");
	Набор = ТестовыеДанные.ОписаниеТестовогоНабора(Модуль, "ТестовыйНаборCTRF");
	
	Тест1 = ТестовыеДанные.ОписаниеТеста(Модуль, Набор);
	Тест1.Имя = "ПервыйТест";
	Тест1.Статус = Статусы.Успешно;
	Тест1.ДатаСтарта = 62135596800000 + 1000; // Unix-время 1000 мс
	Тест1.Длительность = 500;
	Набор.Тесты.Добавить(Тест1);
	
	Тест2 = ТестовыеДанные.ОписаниеТеста(Модуль, Набор);
	Тест2.Имя = "ВторойТест";
	Тест2.Статус = Статусы.Ошибка;
	Тест2.ДатаСтарта = 62135596800000 + 2000; // Unix-время 2000 мс
	Тест2.Длительность = 100;
	Тест2.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка второго теста", "Стек второго теста"));
	Набор.Тесты.Добавить(Тест2);
	
	Модуль.НаборыТестов.Добавить(Набор);
	РезультатВыполнения.Добавить(Модуль);
	
	Тесты = ЮТОтчетCTRFСлужебный.ТестыОтчета(РезультатВыполнения);
	
	ЮТест.ОжидаетЧто(Тесты, "Записи тестов обычного прогона")
		.ИмеетТип("Массив")
		.ИмеетДлину(2);
	
	Первый = Тесты[0];
	ЮТест.ОжидаетЧто(Первый, "Первая запись")
		.Свойство("name").Равно("ПервыйТест")
		.Свойство("status").Равно("passed")
		.Свойство("start").Равно(1000)
		.Свойство("duration").Равно(500)
		.Свойство("suite[0]").Равно("ТестовыйМодульCTRF")
		.Свойство("suite[1]").Равно("ТестовыйНаборCTRF");
	
	Второй = Тесты[1];
	ЮТест.ОжидаетЧто(Второй, "Вторая запись")
		.Свойство("name").Равно("ВторойТест")
		.Свойство("status").Равно("failed")
		.Свойство("start").Равно(2000)
		.Свойство("duration").Равно(100)
		.Свойство("message").Равно("Ошибка второго теста");
	
КонецПроцедуры

// Тест синтетической записи для набора с ошибками и без тестов:
// name = "Представление [Режим]", suite = [имя модуля], status = failed, duration = 0.
Процедура ТестыОтчета_ОшибкиНабора() Экспорт
	
	РезультатВыполнения = Новый Массив;
	Модуль = ТестовыеДанные.ОписаниеТестовогоМодуля("ТестовыйМодульCTRF");
	Набор = ТестовыеДанные.ОписаниеТестовогоНабора(Модуль, "ТестовыйНаборCTRF", "Представление набора");
	Набор.Режим = "Сервер";
	Набор.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка набора", "Стек ошибки набора"));
	Модуль.НаборыТестов.Добавить(Набор);
	РезультатВыполнения.Добавить(Модуль);
	
	Тесты = ЮТОтчетCTRFСлужебный.ТестыОтчета(РезультатВыполнения);
	
	ЮТест.ОжидаетЧто(Тесты, "Записи прогона с ошибкой набора")
		.ИмеетДлину(1);
	
	Запись = Тесты[0];
	ЮТест.ОжидаетЧто(Запись, "Синтетическая запись набора с ошибкой")
		.Свойство("name").Равно("Представление набора [Сервер]")
		.Свойство("status").Равно("failed")
		.Свойство("duration").Равно(0)
		.Свойство("message").Равно("Ошибка набора")
		.Свойство("trace").Равно("Стек ошибки набора")
		.Свойство("suite").ИмеетДлину(1)
		.Свойство("suite[0]").Равно("ТестовыйМодульCTRF")
		.НетСвойства("start");
	
КонецПроцедуры

// Тест синтетической записи для модуля с ошибками и без наборов:
// suite опускается (пустой массив запрещён схемой CTRF), status = failed, duration = 0.
Процедура ТестыОтчета_ОшибкиМодуля() Экспорт
	
	РезультатВыполнения = Новый Массив;
	Модуль = ТестовыеДанные.ОписаниеТестовогоМодуля("ТестовыйМодульCTRF");
	Модуль.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка модуля", "Стек ошибки модуля"));
	РезультатВыполнения.Добавить(Модуль);
	
	Тесты = ЮТОтчетCTRFСлужебный.ТестыОтчета(РезультатВыполнения);
	
	ЮТест.ОжидаетЧто(Тесты, "Записи прогона с ошибкой модуля")
		.ИмеетДлину(1);
	
	Запись = Тесты[0];
	ЮТест.ОжидаетЧто(Запись, "Синтетическая запись модуля с ошибкой")
		.Свойство("name").Равно("ТестовыйМодульCTRF")
		.Свойство("status").Равно("failed")
		.Свойство("duration").Равно(0)
		.Свойство("message").Равно("Ошибка модуля")
		.Свойство("trace").Равно("Стек ошибки модуля")
		.НетСвойства("suite")
		.НетСвойства("start");
	
КонецПроцедуры

// Тест формирования двоичных данных CTRF-отчета из результата тестирования.
// Проверяет полную структуру корня документа: reportFormat, specVersion, results.tool/summary/tests/environment,
// корректность UTF-8 сериализации русских строк и соответствие сводки числу тестов.
Процедура ДанныеОтчета() Экспорт
	
	Статусы = ЮТФабрика.СтатусыИсполненияТеста();
	
	РезультатВыполнения = Новый Массив;
	Модуль = ТестовыеДанные.ОписаниеТестовогоМодуля("ТестовыйМодульCTRF");
	Набор = ТестовыеДанные.ОписаниеТестовогоНабора(Модуль, "ТестовыйНаборCTRF");
	
	Тест1 = ТестовыеДанные.ОписаниеТеста(Модуль, Набор);
	Тест1.Имя = "ПервыйТест";
	Тест1.Статус = Статусы.Успешно;
	Тест1.ДатаСтарта = 62135596800000 + 1000; // Unix-время 1000 мс
	Тест1.Длительность = 500;
	Набор.Тесты.Добавить(Тест1);
	
	Тест2 = ТестовыеДанные.ОписаниеТеста(Модуль, Набор);
	Тест2.Имя = "ВторойТест";
	Тест2.Статус = Статусы.Ошибка;
	Тест2.ДатаСтарта = 62135596800000 + 2000; // Unix-время 2000 мс
	Тест2.Длительность = 100;
	Тест2.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка второго теста", "Стек второго теста"));
	Набор.Тесты.Добавить(Тест2);
	
	Модуль.НаборыТестов.Добавить(Набор);
	РезультатВыполнения.Добавить(Модуль);
	
	Данные = ЮТОтчетCTRFСлужебный.ДанныеОтчета(РезультатВыполнения, Неопределено);
	Документ = ПрочитатьДокументОтчета(Данные);
	
	ЮТест.ОжидаетЧто(Документ, "Корень CTRF-отчета")
		.Свойство("reportFormat").Равно("CTRF")
		.Свойство("specVersion").Равно("0.2.0")
		.Свойство("results").ИмеетТип("Структура");
	
	Результаты = Документ.results;
	ЮТест.ОжидаетЧто(Результаты, "Раздел results")
		.Свойство("tool").ИмеетТип("Структура")
		.Свойство("tool.name").Равно("YAxUnit")
		.Свойство("tool.version").Заполнено()
		.Свойство("summary").ИмеетТип("Структура")
		.Свойство("summary.tests").Равно(2)
		.Свойство("summary.passed").Равно(1)
		.Свойство("summary.failed").Равно(1)
		.Свойство("summary.start").Равно(1000)
		.Свойство("summary.stop").Равно(2100)
		.Свойство("tests").ИмеетТип("Массив")
		.ИмеетДлину(2);
	
	// Русские строки проходят сериализацию без искажений
	ПервыйТест = Результаты.tests[0];
	ЮТест.ОжидаетЧто(ПервыйТест, "Первая запись теста")
		.Свойство("name").Равно("ПервыйТест")
		.Свойство("status").Равно("passed")
		.Свойство("duration").Равно(500)
		.Свойство("start").Равно(1000)
		.Свойство("suite").ИмеетДлину(2)
		.Свойство("suite[0]").Равно("ТестовыйМодульCTRF")
		.Свойство("suite[1]").Равно("ТестовыйНаборCTRF");
	
	ВторойТест = Результаты.tests[1];
	ЮТест.ОжидаетЧто(ВторойТест, "Вторая запись теста")
		.Свойство("name").Равно("ВторойТест")
		.Свойство("status").Равно("failed")
		.Свойство("message").Равно("Ошибка второго теста")
		.Свойство("trace").Равно("Стек второго теста");
	
	// Раздел environment заполняется по фактическому окружению ИБ (не пустые поля)
	Окружение = ЮТест.Окружение();
	ЮТест.ОжидаетЧто(Результаты, "Раздел environment при заполненном окружении")
		.Свойство("environment").ИмеетТип("Структура")
		.Свойство("environment.appName").Равно(Окружение.Конфигурация)
		.Свойство("environment.osPlatform").Равно(Окружение.ОперационнаяСистемаСервер);
	
КонецПроцедуры

// Тест формирования CTRF-отчета для пустого прогона:
// summary.tests = 0, все счётчики 0, start/stop = 0, tests - пустой массив.
Процедура ДанныеОтчета_ПустойПрогон() Экспорт
	
	Данные = ЮТОтчетCTRFСлужебный.ДанныеОтчета(Новый Массив, Неопределено);
	Документ = ПрочитатьДокументОтчета(Данные);
	
	ЮТест.ОжидаетЧто(Документ, "Корень CTRF-отчета пустого прогона")
		.Свойство("reportFormat").Равно("CTRF")
		.Свойство("specVersion").Равно("0.2.0")
		.Свойство("results.tool.name").Равно("YAxUnit")
		.Свойство("results.summary.tests").Равно(0)
		.Свойство("results.summary.passed").Равно(0)
		.Свойство("results.summary.failed").Равно(0)
		.Свойство("results.summary.pending").Равно(0)
		.Свойство("results.summary.skipped").Равно(0)
		.Свойство("results.summary.other").Равно(0)
		.Свойство("results.summary.start").Равно(0)
		.Свойство("results.summary.stop").Равно(0)
		.Свойство("results.tests").ИмеетДлину(0)
		.Свойство("results.environment").ИмеетТип("Структура");
	
КонецПроцедуры

// Тест защиты от неопределенного стека ошибки (ошибка не является ИнформацияОбОшибке, см. ЮТРегистрацияОшибокСлужебный.СтекОшибки).
// Незаполненные message/trace - опциональные поля CTRF, вставка Неопределено дает JSON null и ломает strict-схему,
// поэтому поля с незаполненными значениями не вставляются вовсе.
Процедура ОписаниеТеста_ОшибкаБезСтека() Экспорт
	
	Статусы = ЮТФабрика.СтатусыИсполненияТеста();
	
	// Ошибка исполнения без стека: только сообщение
	Данные = НовыеТестовыеДанные(Статусы.Ошибка);
	Данные.Тест.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка без стека", Неопределено));
	Описание = ЮТОтчетCTRFСлужебный.ОписаниеТеста(Данные.Тест, Данные.Набор, Данные.Модуль);
	
	ЮТест.ОжидаетЧто(Описание, "Описание упавшего теста без стека")
		.Свойство("status").Равно("failed")
		.Свойство("message").Равно("Ошибка без стека")
		.НетСвойства("trace");
	
	// Ошибка без стека и без сообщения
	Данные = НовыеТестовыеДанные(Статусы.Ошибка);
	Данные.Тест.Ошибки.Добавить(НовоеОписаниеОшибки(Неопределено, Неопределено));
	Описание = ЮТОтчетCTRFСлужебный.ОписаниеТеста(Данные.Тест, Данные.Набор, Данные.Модуль);
	
	ЮТест.ОжидаетЧто(Описание, "Описание упавшего теста без сообщения и стека")
		.Свойство("status").Равно("failed")
		.НетСвойства("message")
		.НетСвойства("trace");
	
	// Сериализация записи с ошибкой без стека не дает JSON null
	Данные = НовыеТестовыеДанные(Статусы.Ошибка);
	Данные.Тест.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка без стека", Неопределено));
	Данные.Набор.Тесты.Добавить(Данные.Тест);
	Данные.Модуль.НаборыТестов.Добавить(Данные.Набор);
	Документ = ПрочитатьДокументОтчета(ЮТОтчетCTRFСлужебный.ДанныеОтчета(
		ЮТКоллекции.ЗначениеВМассиве(Данные.Модуль), Неопределено));
	
	ЮТест.ОжидаетЧто(Документ.results.tests[0], "Сериализованная запись без стека")
		.Свойство("status").Равно("failed")
		.Свойство("message").Равно("Ошибка без стека")
		.НетСвойства("trace");
	
КонецПроцедуры

// Тест синтетической записи набора с ошибкой без стека: поле trace не вставляется.
Процедура ТестыОтчета_ОшибкаНабораБезСтека() Экспорт
	
	РезультатВыполнения = Новый Массив;
	Модуль = ТестовыеДанные.ОписаниеТестовогоМодуля("ТестовыйМодульCTRF");
	Набор = ТестовыеДанные.ОписаниеТестовогоНабора(Модуль, "ТестовыйНаборCTRF", "Представление набора");
	Набор.Режим = "Сервер";
	Набор.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка набора без стека", Неопределено));
	Модуль.НаборыТестов.Добавить(Набор);
	РезультатВыполнения.Добавить(Модуль);
	
	Тесты = ЮТОтчетCTRFСлужебный.ТестыОтчета(РезультатВыполнения);
	
	ЮТест.ОжидаетЧто(Тесты, "Записи прогона с ошибкой набора без стека")
		.ИмеетДлину(1);
	
	ЮТест.ОжидаетЧто(Тесты[0], "Синтетическая запись набора с ошибкой без стека")
		.Свойство("status").Равно("failed")
		.Свойство("message").Равно("Ошибка набора без стека")
		.НетСвойства("trace");
	
КонецПроцедуры

// Тест формирования CTRF-отчета с полным составом данных: все статусы исполнения YAxUnit,
// синтетические записи ошибок набора и модуля, русские строки.
// Файл отчета пишется во временный файл (см. ПрочитатьДокументОтчета) и пригоден для внешней strict-валидации.
Процедура ДанныеОтчета_ПолныйСоставДанных() Экспорт
	
	Статусы = ЮТФабрика.СтатусыИсполненияТеста();
	РезультатВыполнения = Новый Массив;
	
	// Модуль 1: все статусы тестов + ошибка набора
	Модуль1 = ТестовыеДанные.ОписаниеТестовогоМодуля("МодульВсехСтатусов");
	Набор1 = ТестовыеДанные.ОписаниеТестовогоНабора(Модуль1, "НаборВсехСтатусов", "Набор всех статусов");
	Набор1.Режим = "Сервер";
	
	ДобавитьТестВНабор(Модуль1, Набор1, "ТестУспешно", Статусы.Успешно, 62135596801000, 100);
	ДобавитьТестВНабор(Модуль1, Набор1, "ТестОшибка", Статусы.Ошибка, 62135596801200, 50, НовоеОписаниеОшибки("Ошибка исполнения", "Стек ошибки исполнения"));
	ДобавитьТестВНабор(Модуль1, Набор1, "ТестСломан", Статусы.Сломан, 62135596801300, 20, НовоеОписаниеОшибки("Проверка провалена", "Стек сломанного"));
	ДобавитьТестВНабор(Модуль1, Набор1, "ТестПропущен", Статусы.Пропущен, 0, 0, НовоеОписаниеОшибки("Причина пропуска", Неопределено));
	ДобавитьТестВНабор(Модуль1, Набор1, "ТестНеРеализован", Статусы.НеРеализован, 0, 0);
	ДобавитьТестВНабор(Модуль1, Набор1, "ТестОжидание", Статусы.Ожидание, 0, 0);
	
	Набор1.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка набора", "Стек ошибки набора"));
	Модуль1.НаборыТестов.Добавить(Набор1);
	РезультатВыполнения.Добавить(Модуль1);
	
	// Модуль 2: ошибка уровня модуля (загрузки), синтетическая запись без suite
	Модуль2 = ТестовыеДанные.ОписаниеТестовогоМодуля("МодульСОшибкой");
	Модуль2.Ошибки.Добавить(НовоеОписаниеОшибки("Ошибка загрузки модуля", Неопределено));
	РезультатВыполнения.Добавить(Модуль2);
	
	Данные = ЮТОтчетCTRFСлужебный.ДанныеОтчета(РезультатВыполнения, Неопределено);
	Документ = ПрочитатьДокументОтчета(Данные);
	Тесты = Документ.results.tests;
	
	ЮТест.ОжидаетЧто(Документ.results.summary, "Сводка полного состава")
		.Свойство("tests").Равно(8)
		.Свойство("passed").Равно(1)
		.Свойство("failed").Равно(4)
		.Свойство("skipped").Равно(3)
		.Свойство("other").Равно(0)
		.Свойство("start").Равно(1000);
	
	ЮТест.ОжидаетЧто(Тесты[0], "Запись успешного теста")
		.Свойство("status").Равно("passed");
	ЮТест.ОжидаетЧто(Тесты[1], "Запись упавшего теста")
		.Свойство("status").Равно("failed")
		.Свойство("message").Равно("Ошибка исполнения")
		.Свойство("trace").Равно("Стек ошибки исполнения");
	ЮТест.ОжидаетЧто(Тесты[2], "Запись сломанного теста")
		.Свойство("status").Равно("failed")
		.Свойство("rawStatus").Равно("Сломан");
	ЮТест.ОжидаетЧто(Тесты[3], "Запись пропущенного теста с ошибкой пропуска")
		.Свойство("status").Равно("skipped")
		.НетСвойства("message")
		.НетСвойства("trace");
	ЮТест.ОжидаетЧто(Тесты[4], "Запись нереализованного теста")
		.Свойство("status").Равно("skipped")
		.Свойство("rawStatus").Равно("НеРеализован");
	ЮТест.ОжидаетЧто(Тесты[5], "Запись теста в статусе ожидания")
		.Свойство("status").Равно("skipped")
		.Свойство("rawStatus").Равно("Ожидание");
	ЮТест.ОжидаетЧто(Тесты[6], "Синтетическая запись ошибки набора")
		.Свойство("status").Равно("failed")
		.Свойство("message").Равно("Ошибка набора")
		.Свойство("trace").Равно("Стек ошибки набора");
	ЮТест.ОжидаетЧто(Тесты[7], "Синтетическая запись ошибки модуля")
		.Свойство("status").Равно("failed")
		.Свойство("message").Равно("Ошибка загрузки модуля")
		.НетСвойства("trace")
		.НетСвойства("suite");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует тестовые данные результата теста с указанным статусом.
// ДатаСтарта = 62135596800000 + 1000 соответствует Unix-времени 1000 мс.
//
// Параметры:
//  Статус - Строка - Статус исполнения теста, см. ЮТФабрика.СтатусыИсполненияТеста
//
// Возвращаемое значение:
//  Структура - со свойствами:
//   * Модуль - см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//   * Набор - см. ЮТФабрика.ОписаниеИсполняемогоНабораТестов
//   * Тест - см. ЮТФабрика.ОписаниеИсполняемогоТеста
Функция НовыеТестовыеДанные(Статус)
	
	Модуль = ТестовыеДанные.ОписаниеТестовогоМодуля("ТестовыйМодульCTRF");
	Набор = ТестовыеДанные.ОписаниеТестовогоНабора(Модуль, "ТестовыйНаборCTRF");
	Тест = ТестовыеДанные.ОписаниеТеста(Модуль, Набор);
	
	Тест.Имя = "ТестовыйТестCTRF";
	Тест.Статус = Статус;
	Тест.ДатаСтарта = 62135596800000 + 1000; // Unix-время 1000 мс
	Тест.Длительность = 500;
	
	Возврат Новый Структура("Модуль, Набор, Тест", Модуль, Набор, Тест);
	
КонецФункции

// Формирует описание ошибки теста.
//
// Параметры:
//  Сообщение - Строка, Неопределено - Сообщение об ошибке
//  Стек - Строка, Неопределено - Стек ошибки
//
// Возвращаемое значение:
//  см. ЮТФабрикаСлужебный.ОписаниеВозникшейОшибки
Функция НовоеОписаниеОшибки(Знач Сообщение, Знач Стек)
	
	Ошибка = ЮТФабрикаСлужебный.ОписаниеВозникшейОшибки(Сообщение);
	Ошибка.Стек = Стек;
	
	Возврат Ошибка;
	
КонецФункции

// Добавляет в набор тест с указанными параметрами исполнения.
//
// Параметры:
//  Модуль - см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//  Набор - см. ЮТФабрика.ОписаниеИсполняемогоНабораТестов
//  Имя - Строка - Имя теста
//  Статус - Строка - Статус исполнения, см. ЮТФабрика.СтатусыИсполненияТеста
//  ДатаСтарта - Число - Метка времени 1С в миллисекундах от 0001-01-01 (62135596800000 + <Unix-время в мс>) или 0
//  Длительность - Число - Длительность теста в миллисекундах
//  Ошибка - см. ЮТФабрикаСлужебный.ОписаниеВозникшейОшибки, Неопределено - Ошибка теста
Процедура ДобавитьТестВНабор(Знач Модуль, Знач Набор, Знач Имя, Знач Статус, Знач ДатаСтарта, Знач Длительность, Знач Ошибка = Неопределено)
	
	Тест = ТестовыеДанные.ОписаниеТеста(Модуль, Набор);
	
	Тест.Имя = Имя;
	Тест.Статус = Статус;
	Тест.ДатаСтарта = ДатаСтарта;
	Тест.Длительность = Длительность;
	
	Если Ошибка <> Неопределено Тогда
		Тест.Ошибки.Добавить(Ошибка);
	КонецЕсли;
	
	Набор.Тесты.Добавить(Тест);
	
КонецПроцедуры

// Формирует запись теста CTRF для теста сводки.
//
// Параметры:
//  Статус - Строка - Статус теста CTRF (passed/failed/skipped/pending/other)
//  Начало - Число - Время начала теста в Unix-миллисекундах (0 - не заполнено)
//  Длительность - Число - Длительность теста в миллисекундах
//
// Возвращаемое значение:
//  Соответствие - Запись теста CTRF, ключи - строки (name, status, duration, start)
Функция НоваяЗаписьОтчета(Знач Статус, Знач Начало, Знач Длительность)
	
	Запись = Новый Соответствие;
	Запись.Вставить("name", СтрШаблон("Тест%1", Длительность));
	Запись.Вставить("status", Статус);
	Запись.Вставить("duration", Длительность);
	
	Если Начало > 0 Тогда
		Запись.Вставить("start", Начало);
	КонецЕсли;
	
	Возврат Запись;
	
КонецФункции

// Читает JSON-документ из двоичных данных отчета.
//
// Параметры:
//  Данные - ДвоичныеДанные - Данные CTRF-отчета
//
// Возвращаемое значение:
//  Структура - Корень JSON-документа (ключи reportFormat, specVersion, results)
Функция ПрочитатьДокументОтчета(Знач Данные)
	
	ИмяФайла = ЮТест.Данные().НовоеИмяВременногоФайла("json");
	Данные.Записать(ИмяФайла);
	
	Возврат ЮТОбщий.ЗначениеИзJSON(ЮТФайлы.ДанныеТекстовогоФайла(ИмяФайла));
	
КонецФункции

#КонецОбласти
