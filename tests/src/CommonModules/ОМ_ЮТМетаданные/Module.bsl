#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьСерверныйТест("ОписаниеОбъектаМетаданных").СПараметрами(Истина)
		.ДобавитьКлиентскийТест("ОписаниеОбъектаМетаданных").СПараметрами(Ложь)
		.ДобавитьТест("РегистрыДвиженийДокумента")
		.ДобавитьТест("НормализованноеИмяТаблицы")
		.ДобавитьТест("ТипыРеквизитов")
		.ДобавитьТест("ВидОбъектаМетаданныхПоАнглийскомуИмени")
		.ДобавитьТест("КлючевыеСтандартныеРеквизиты")
		;
	
КонецПроцедуры

Процедура ОписаниеОбъектаМетаданных(НаСервере) Экспорт
	
	Данные = ПомощникТестированияВызовСервера.ТестовыеДанныеДляОписаниеОбъектаМетаданных(НаСервере);
	
	Для Каждого Значение Из Данные Цикл
		
		Описание = ЮТМетаданные.ОписаниеОбъектаМетаданных(Значение);
		
		ЮТест.ОжидаетЧто(Описание).Заполнено();
		
	КонецЦикла;
	
	Описание = ЮТМетаданные.ОписаниеОбъектаМетаданных("Справочник.Склады");
	ЮТест.ОжидаетЧто(Описание, "Проверка на общий реквизит")
		.Свойство("Реквизиты")
			.ИмеетСвойство("Организация");
	
КонецПроцедуры

Процедура РегистрыДвиженийДокумента() Экспорт
	
	ЮТест.ОжидаетЧто(ЮТМетаданные.РегистрыДвиженийДокумента("Документ.Заказ"))
		.ИмеетТип("Структура")
		.НеЗаполнено();
	
	ЮТест.ОжидаетЧто(ЮТМетаданные.РегистрыДвиженийДокумента("Документы.ОперацияПоУчетуТоваров"))
		.ИмеетТип("Структура")
		.Заполнено()
		.Свойство("ТоварныеЗапасы").Равно("РегистрНакопления.ТоварныеЗапасы");
	
	ЮТест.ОжидаетЧто(ЮТМетаданные.РегистрыДвиженийДокумента(ПредопределенноеЗначение("Документ.ПриходТовара.ПустаяСсылка")))
		.ИмеетТип("Структура")
		.Заполнено()
		.ИмеетДлину(3)
		.Свойство("ТоварныеЗапасы").Равно("РегистрНакопления.ТоварныеЗапасы")
		.Свойство("Взаиморасчеты").Равно("РегистрНакопления.Взаиморасчеты")
		.Свойство("Основной").Равно("РегистрБухгалтерии.Основной");
	
	ЮТест.ОжидаетЧто(ЮТМетаданные)
		.Метод("РегистрыДвиженийДокумента").Параметр("РегистрНакопления.ТоварныеЗапасы")
		.ВыбрасываетИсключение("Не поддерживается получение движений для РегистрыНакопления.ТоварныеЗапасы");
	
КонецПроцедуры

Процедура НормализованноеИмяТаблицы() Экспорт
	
	Варианты = ЮТКоллекции.ЗначениеВМассиве("Справочник.Банки", "Справочники.Банки", ПредопределенноеЗначение("Справочник.Банки.ПустаяСсылка"));
	
#Если Сервер Тогда
	Варианты.Добавить(Справочники.Банки);
	Варианты.Добавить(Справочники.Банки.СоздатьЭлемент());
#КонецЕсли
	
	Для Каждого Вариант Из Варианты Цикл
		
		Описание = СтрШаблон("%1 (%2)", Вариант, ТипЗнч(Вариант));
		ФактическоеЗначение = ЮТМетаданные.НормализованноеИмяТаблицы(Вариант);
		
		ЮТест.ОжидаетЧто(ФактическоеЗначение, Описание).Равно("Справочник.Банки");
		
	КонецЦикла;
	
	ЮТест.ОжидаетЧто(ЮТМетаданные)
		.Метод("НормализованноеИмяТаблицы").Параметр("123")
		.ВыбрасываетИсключение("Неподдерживаемый параметр метода");
	
КонецПроцедуры

Процедура ТипыРеквизитов() Экспорт
	
	ЮТест.ОжидаетЧто(ЮТМетаданные.ТипыРеквизитов("Документ.Заказ"), "По имени объекта метаданных")
		.ИмеетТип("Структура")
		.Свойство("Дата").ИмеетТип("ОписаниеТипов").Равно(Новый ОписаниеТипов("Дата"))
		.Свойство("Автор")
		.Свойство("ВидЦен")
	;
	
#Если Сервер Тогда
	ЮТест.ОжидаетЧто(ЮТМетаданные.ТипыРеквизитов(РегистрыСведений.КурсыВалют), "По менеджеру")
		.ИмеетТип("Структура")
		.ИмеетСвойство("Период")
		.ИмеетСвойство("Валюта")
		.ИмеетСвойство("Курс")
	;
#КонецЕсли
	
	ЮТест.ОжидаетЧто(ЮТМетаданные.ТипыРеквизитов("РегистрыНакопления.Взаиморасчеты", Истина), "В соответствие")
		.ИмеетТип("Соответствие")
		.ИмеетСвойство("Контрагент")
		.ИмеетСвойство("Регистратор")
		.ИмеетСвойство("Сумма")
	;
	ЮТест.ОжидаетЧто(ЮТМетаданные.ТипыРеквизитов("Документ.Заказ.Товары"), "Реквизиты табличной части")
		.ИмеетТип("Структура")
		.ИмеетСвойство("Товар")
		.НеИмеетСвойства("НомерСтроки")
		.ИмеетСвойство("Количество")
	;
КонецПроцедуры

Процедура ВидОбъектаМетаданныхПоАнглийскомуИмени() Экспорт
	
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоСправочник("Catalog.Банки"), "Catalog").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоСправочник("Catalogs.Банки"), "Catalogs").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоДокумент("Document.Заказ"), "Document").ЭтоИстина();
	
	// В конфигурациях на английском языке описание типа метаданных содержит английские имена (`Catalog`)
	Описание = ОписаниеСАнглийскимТипом("Справочник.Банки", "Catalog");
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоСправочник(Описание), "Catalog").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоДокумент(Описание), "Catalog не документ").ЭтоЛожь();
	
	Описание = ОписаниеСАнглийскимТипом("Документ.Заказ", "Document");
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоДокумент(Описание), "Document").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоРегистр(Описание), "Document не регистр").ЭтоЛожь();
	
	Описание = ОписаниеСАнглийскимТипом("ПланВидовХарактеристик.ВидыСубконто", "ChartOfCharacteristicTypes");
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоПланВидовХарактеристик(Описание), "ChartOfCharacteristicTypes").ЭтоИстина();
	
	Описание = ОписаниеСАнглийскимТипом("ПланСчетов.Основной", "ChartOfAccounts");
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоПланСчетов(Описание), "ChartOfAccounts").ЭтоИстина();
	
	Описание = ОписаниеСАнглийскимТипом("Перечисление.ВидыТоваров", "Enum");
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоПеречисление(Описание), "Enum").ЭтоИстина();
	
	Описание = ОписаниеСАнглийскимТипом("РегистрСведений.КурсыВалют", "InformationRegister");
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоРегистрСведений(Описание), "InformationRegister").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоРегистр(Описание), "InformationRegister - регистр").ЭтоИстина();
	
	Описание = ОписаниеСАнглийскимТипом("РегистрБухгалтерии.Основной", "AccountingRegister");
	ЮТест.ОжидаетЧто(ЮТМетаданные.ЭтоРегистрБухгалтерии(Описание), "AccountingRegister").ЭтоИстина();
	
КонецПроцедуры

Процедура КлючевыеСтандартныеРеквизиты() Экспорт
	
	// Имена стандартных реквизитов в описании совпадают с именами метаданных: `Ссылка` или `Ref`
	ИмяСсылки = ?(ЮТОкружение.ИспользуетсяАнглийскийВстроенныйЯзык(), "Ref", "Ссылка");
	ИмяДаты = ?(ЮТОкружение.ИспользуетсяАнглийскийВстроенныйЯзык(), "Date", "Дата");
	ИмяПериода = ?(ЮТОкружение.ИспользуетсяАнглийскийВстроенныйЯзык(), "Period", "Период");
	
	Реквизиты = ЮТМетаданные.ОписаниеОбъектаМетаданных("Документ.ПоступлениеДенег").Реквизиты;
	ЮТест.ОжидаетЧто(Реквизиты[ИмяСсылки].ЭтоКлюч, "Ссылка документа").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты[ИмяДаты].ЭтоКлюч, "Дата документа").ЭтоЛожь();
	
	Реквизиты = ЮТМетаданные.ОписаниеОбъектаМетаданных("Справочник.Товары").Реквизиты;
	ЮТест.ОжидаетЧто(Реквизиты[ИмяСсылки].ЭтоКлюч, "Ссылка справочника").ЭтоИстина();
	
	Реквизиты = ЮТМетаданные.ОписаниеОбъектаМетаданных("РегистрСведений.КурсыВалют").Реквизиты;
	ЮТест.ОжидаетЧто(Реквизиты[ИмяПериода].ЭтоКлюч, "Период регистра сведений").ЭтоИстина();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание объекта метаданных в том виде, в котором его формирует конфигурация на английском языке.
// 
// Параметры:
//  ПолноеИмя - Строка - Полное имя объекта метаданных
//  ИмяТипа - Строка - Английское имя типа метаданных, например, `Catalog`
// 
// Возвращаемое значение:
//  см. ЮТМетаданные.СтруктураОписанияОбъектаМетаданных
Функция ОписаниеСАнглийскимТипом(ПолноеИмя, ИмяТипа)
	
	Описание = Новый Структура(ЮТМетаданные.ОписаниеОбъектаМетаданных(ПолноеИмя));
	Описание.ОписаниеТипа = ЮТМетаданные.ТипыМетаданных()[ИмяТипа];
	
	//@skip-check constructor-function-return-section
	Возврат Описание;
	
КонецФункции

#КонецОбласти
