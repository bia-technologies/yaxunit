#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТест("СформироватьОтчет_Allure")
		.ДобавитьТест("СформироватьОтчет_CTRF")
		.ДобавитьТест("СформироватьНесколькоОтчетов")
		.ДобавитьТест("СформироватьНесколькоОтчетов_CTRF");
	
КонецПроцедуры

Процедура СформироватьОтчет_Allure() Экспорт
	
	РезультатТестирования = ТестовыеДанные.РезультатТестирования();
	Каталог = ЮТест.Данные().НовоеИмяВременногоФайла();
	СоздатьКаталог(Каталог);
	
	ПараметрыЗапуска = Новый Структура();
	ПараметрыЗапуска.Вставить("reportPath", Каталог);
	ПараметрыЗапуска.Вставить("reportFormat", "allure");
	ЮТОтчетСлужебный.СформироватьОтчет(РезультатТестирования, ПараметрыЗапуска, Неопределено);
	
КонецПроцедуры

// Интеграционный тест одиночного CTRF-отчета: reportFormat = "ctrf" + reportPath.
// Доказывает регистрацию формата в реестре генераторов (метаданные) и диспетчеризацию движком отчетов.
// Движок записывает отчет асинхронно через цепочку оповещений, поэтому тест вызывает
// экспортный шаг цепочки ПослеФормированияИмениФайла - он синхронно формирует и записывает файл.
Процедура СформироватьОтчет_CTRF() Экспорт
	
	РезультатТестирования = ТестовыеДанные.РезультатТестирования();
	
	Каталог = ЮТест.Данные().НовоеИмяВременногоФайла();
	СоздатьКаталог(Каталог);
	ФайлCTRF = ЮТФайлы.ОбъединитьПути(Каталог, "ctrf-report.json");
	
	ПараметрыЗапуска = Новый Структура();
	ПараметрыЗапуска.Вставить("reportPath", ФайлCTRF);
	ПараметрыЗапуска.Вставить("reportFormat", "ctrf");
	
	СформироватьОтчетВФорматеCTRF(РезультатТестирования, ПараметрыЗапуска, ФайлCTRF);
	ПроверитьФайлОтчетаCTRF(ФайлCTRF);
	
КонецПроцедуры

Процедура СформироватьНесколькоОтчетов() Экспорт
	
	РезультатТестирования = ТестовыеДанные.РезультатТестирования();
	
	КаталогAllure = ЮТест.Данные().НовоеИмяВременногоФайла();
	СоздатьКаталог(КаталогAllure);
	ФайлJUnit = ЮТест.Данные().НовоеИмяВременногоФайла();
	
	ПараметрыЗапуска = Новый Структура();
	ПараметрыЗапуска.Вставить("reportPath", ФайлJUnit);
	ПараметрыЗапуска.Вставить("reports", Новый Массив);
	ПараметрыЗапуска.reports.Добавить(Новый Структура("format, path", "jUnit", ФайлJUnit));
	ПараметрыЗапуска.reports.Добавить(Новый Структура("format, path", "allure", КаталогAllure));
	
	ЮТОтчетСлужебный.СформироватьОтчет(РезультатТестирования, ПараметрыЗапуска, Неопределено);
	
	ЮТест.ОжидаетЧто(ФайлJUnit)
		.Существует();
	ЮТест.ОжидаетЧто(КаталогAllure)
		.Существует();
	
КонецПроцедуры

// Интеграционный тест множественных отчетов с CTRF: reports = [{format: "ctrf", path: ...}].
// Движок записывает отчет асинхронно через цепочку оповещений, поэтому тест вызывает
// экспортный шаг цепочки ПослеФормированияИмениФайла - он синхронно формирует и записывает файл.
Процедура СформироватьНесколькоОтчетов_CTRF() Экспорт
	
	РезультатТестирования = ТестовыеДанные.РезультатТестирования();
	
	ФайлCTRF = ЮТест.Данные().НовоеИмяВременногоФайла();
	
	ПараметрыЗапуска = Новый Структура();
	ПараметрыЗапуска.Вставить("reportPath", ФайлCTRF);
	ПараметрыЗапуска.Вставить("reports", Новый Массив);
	ПараметрыЗапуска.reports.Добавить(Новый Структура("format, path", "ctrf", ФайлCTRF));
	
	СформироватьОтчетВФорматеCTRF(РезультатТестирования, ПараметрыЗапуска, ФайлCTRF);
	ПроверитьФайлОтчетаCTRF(ФайлCTRF);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Синхронно формирует CTRF-отчет через экспортный шаг цепочки формирования отчета движка.
// Диспетчеризация формата выполняется движком (МодульФормирования), как в реальном прогоне.
//
// Параметры:
//  РезультатТестирования - Массив из см. ЮТФабрика.ОписаниеИсполняемогоТестовогоМодуля
//  ПараметрыЗапуска - Структура - Параметры запуска (reportPath, reportFormat/reports)
//  ИмяФайлаОтчета - Строка - Путь к файлу отчета
Процедура СформироватьОтчетВФорматеCTRF(РезультатТестирования, ПараметрыЗапуска, ИмяФайлаОтчета)
	
	Модули = ЮТПодключаемыеМодулиСлужебный.ГенераторыОтчетов();
	
	МодульОтчета = Неопределено;
	Для Каждого Модуль Из Модули Цикл
		
		Если Модуль.ПараметрыГенерацииОтчета().Форматы.Свойство("ctrf") Тогда
			МодульОтчета = Модуль;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ЮТест.ОжидаетЧто(МодульОтчета <> Неопределено, "Генератор формата ctrf зарегистрирован в реестре метаданными")
		.ЭтоИстина();
	
	Если МодульОтчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Формат = МодульОтчета.ПараметрыГенерацииОтчета().Форматы.ctrf;
	
	ПараметрыФормирования = Новый Структура;
	ПараметрыФормирования.Вставить("РезультатВыполнения", РезультатТестирования);
	ПараметрыФормирования.Вставить("ПараметрыЗапуска", ПараметрыЗапуска);
	ПараметрыФормирования.Вставить("Обработчик", Неопределено);
	ПараметрыФормирования.Вставить("МодульОтчета", МодульОтчета);
	ПараметрыФормирования.Вставить("Формат", Формат);
	
	ЮТОтчетСлужебный.ПослеФормированияИмениФайла(ИмяФайлаОтчета, ПараметрыФормирования);
	
КонецПроцедуры

// Проверяет созданный CTRF-отчет: файл существует и содержит корневые поля спецификации.
//
// Параметры:
//  ФайлCTRF - Строка - Путь к файлу отчета
Процедура ПроверитьФайлОтчетаCTRF(Знач ФайлCTRF)
	
	ФайлОтчета = Новый Файл(ФайлCTRF);
	ЮТест.ОжидаетЧто(ФайлОтчета.Существует(), "Файл CTRF-отчета создан")
		.ЭтоИстина();
	
	Документ = ПрочитатьОтчет(ФайлCTRF);
	ЮТест.ОжидаетЧто(Документ, "CTRF-отчет")
		.Свойство("reportFormat").Равно("CTRF")
		.Свойство("specVersion").Равно("0.2.0")
		.Свойство("results.tool.name").Равно("YAxUnit")
		.Свойство("results.summary.tests").Равно(1)
		.Свойство("results.tests").ИмеетТип("Массив");
	
КонецПроцедуры

// Читает JSON-документ отчета из файла.
//
// Параметры:
//  ИмяФайла - Строка - Путь к файлу отчета
//
// Возвращаемое значение:
//  Структура - Корень JSON-документа
Функция ПрочитатьОтчет(Знач ИмяФайла)
	
	Возврат ЮТОбщий.ЗначениеИзJSON(ЮТФайлы.ДанныеТекстовогоФайла(ИмяФайла));
	
КонецФункции

#КонецОбласти
