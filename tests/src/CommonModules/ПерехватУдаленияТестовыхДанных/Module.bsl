#Область СлужебныйПрограммныйИнтерфейс

// Обработчик события `ПередУдалениемТестовыхДанных` для самотестов.
//
// Фиксирует факт вызова события в структуре `ПерехватУдаления` контекста модуля `ОМ_ЮТТестовыеДанныеСлужебный`
// (создается в его `ПередВсемиТестами`) и выполняет действия по установленному тестом режиму:
//  * "Отмена" - сбрасывает признак стандартной обработки (штатное удаление уровня не выполняется);
//  * "ИсключитьСсылки" - удаляет ссылочные значения из полученной коллекции (эмуляция самостоятельного удаления);
//  * "Ошибка" - возбуждает исключение (проверка устойчивости прогона к ошибкам обработчика).
//
// Параметры:
//  Объекты - Массив - тестовые данные уровня исполнения
//  СтандартнаяОбработка - Булево - признак выполнения штатного удаления
Процедура ПередУдалениемТестовыхДанных(Объекты, СтандартнаяОбработка) Экспорт
	
	Перехват = ЮТест.Контекст().Значение("ПерехватУдаления");
	
	Если Перехват = Неопределено Тогда
		// Прогон чужого модуля - полный no-op.
		Возврат;
	КонецЕсли;
	
	Перехват.Вызвано = Истина;
	Перехват.КоличествоВызовов = Перехват.КоличествоВызовов + 1;
	Перехват.РазмерыКоллекций.Добавить(Объекты.Количество());
	Перехват.Коллекции.Добавить(ЮТКоллекции.СкопироватьМассив(Объекты));
	
	Если Перехват.Режим = "Отмена" Тогда
		СтандартнаяОбработка = Ложь;
		Перехват.Режим = ""; // Отмена одноразовая: не должна распространяться на очистки последующих уровней
	ИначеЕсли Перехват.Режим = "ИсключитьСсылки" Тогда
		Индекс = Объекты.ВГраница();
		Пока Индекс >= 0 Цикл
			Если ЮТТипыДанныхСлужебный.ЭтоСсылочныйТип(ТипЗнч(Объекты[Индекс])) Тогда
				Объекты.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	ИначеЕсли Перехват.Режим = "Ошибка" Тогда
		ВызватьИсключение "Тестовая ошибка обработчика события ПередУдалениемТестовыхДанных";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти